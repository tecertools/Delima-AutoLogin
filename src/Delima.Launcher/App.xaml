<Application x:Class="Delima.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Theming/DefaultTheme.xaml" />
                <ResourceDictionary Source="Theming/Styles.xaml" />
                <ResourceDictionary Source="Theming/ControlTemplates.xaml" />
                <ResourceDictionary Source="Theming/AvatarTemplates.xaml" />
                <ResourceDictionary Source="Theming/PicturePasswordTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
