<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Avatar Vector Templates -->
    <!-- Default / Cat (Kucing) -->
    <DataTemplate x:Key="Avatar_cat">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <!-- Cat head & ears -->
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Canvas.Left="7" Canvas.Top="8" />
                <Polygon Points="8,10 11,2 15,10" Fill="{DynamicResource PrimaryBrush}" />
                <Polygon Points="19,10 23,2 26,10" Fill="{DynamicResource PrimaryBrush}" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="12" Canvas.Top="16" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="19" Canvas.Top="16" />
                <Path Data="M 15 21 L 17 23 L 19 21" Stroke="#1A1208" StrokeThickness="1.2" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Fish (Ikan) -->
    <DataTemplate x:Key="Avatar_fish">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource AccentBrush}" Width="18" Height="13" Canvas.Left="6" Canvas.Top="11" />
                <Polygon Points="22,17 30,10 30,24" Fill="{DynamicResource AccentBrush}" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="10" Canvas.Top="15" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Flower (Bunga) -->
    <DataTemplate x:Key="Avatar_flower">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="12.5" Canvas.Top="4" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="21" Canvas.Top="12.5" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="12.5" Canvas.Top="21" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="4" Canvas.Top="12.5" />
                <Ellipse Fill="#FAEEDA" Width="8" Height="8" Canvas.Left="13" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Car (Kereta) -->
    <DataTemplate x:Key="Avatar_car">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Fill="{DynamicResource ClassColour2}" Width="24" Height="9" RadiusX="3" RadiusY="3" Canvas.Left="5" Canvas.Top="15" />
                <Rectangle Fill="{DynamicResource ClassColour2}" Width="14" Height="8" RadiusX="3" RadiusY="3" Canvas.Left="10" Canvas.Top="9" />
                <Ellipse Fill="#1A1208" Width="6" Height="6" Canvas.Left="9" Canvas.Top="21" />
                <Ellipse Fill="#1A1208" Width="6" Height="6" Canvas.Left="19" Canvas.Top="21" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Star (Bintang) -->
    <DataTemplate x:Key="Avatar_star">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="17,3 20.5,13 31,13 22.5,19.5 26,30 17,23.5 8,30 11.5,19.5 3,13 13.5,13" Fill="{DynamicResource AccentBrush}" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Apple (Epal) -->
    <DataTemplate x:Key="Avatar_apple">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="18" Height="18" Canvas.Left="8" Canvas.Top="11" />
                <Path Data="M 17 11 C 17 7 20 6 21 7" Stroke="#5C5344" StrokeThickness="1.6" />
                <Ellipse Fill="#639922" Width="5" Height="3" Canvas.Left="19" Canvas.Top="7" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Balloon (Belon) -->
    <DataTemplate x:Key="Avatar_balloon">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour1}" Width="16" Height="19" Canvas.Left="9" Canvas.Top="5" />
                <Polygon Points="15,24 19,24 17,27" Fill="{DynamicResource ClassColour1}" />
                <Path Data="M 17 27 L 17 32" Stroke="#5C5344" StrokeThickness="1.4" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Umbrella (Payung) -->
    <DataTemplate x:Key="Avatar_umbrella">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 5 18 A 12 12 0 0 1 29 18 Z" Fill="{DynamicResource ClassColour6}" />
                <Path Data="M 17 18 L 17 28 C 17 31 21 31 21 28" Stroke="#5C5344" StrokeThickness="1.8" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Kite (Layang-layang) -->
    <DataTemplate x:Key="Avatar_kite">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="17,4 27,17 17,30 7,17" Fill="{DynamicResource ClassColour5}" />
                <Line X1="17" Y1="4" X2="17" Y2="30" Stroke="#5C5344" StrokeThickness="1" />
                <Line X1="7" Y1="17" X2="27" Y2="17" Stroke="#5C5344" StrokeThickness="1" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Turtle (Penyu) -->
    <DataTemplate x:Key="Avatar_turtle">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour5}" Width="18" Height="14" Canvas.Left="7" Canvas.Top="11" />
                <Ellipse Fill="{DynamicResource ClassColour5}" Width="7" Height="7" Canvas.Left="23" Canvas.Top="9" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="26" Canvas.Top="11" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Crocodile (Buaya) -->
    <DataTemplate x:Key="Avatar_crocodile">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Fill="#51B36A" Width="22" Height="13" RadiusX="4" RadiusY="4" Canvas.Left="6" Canvas.Top="13" />
                <Ellipse Fill="#51B36A" Width="7" Height="7" Canvas.Left="8" Canvas.Top="9" />
                <Ellipse Fill="#51B36A" Width="7" Height="7" Canvas.Left="17" Canvas.Top="9" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="10.5" Canvas.Top="11" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="19.5" Canvas.Top="11" />
                <Path Data="M 7 21 L 10 18 L 13 21 L 16 18 L 19 21 L 22 18 L 25 21" Stroke="#FFFFFF" StrokeThickness="1" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Eagle (Helang) -->
    <DataTemplate x:Key="Avatar_eagle">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#6B4226" Width="18" Height="20" Canvas.Left="7" Canvas.Top="7" />
                <Polygon Points="18,14 30,19 18,24" Fill="#F7941D" />
                <Ellipse Fill="#FFFFFF" Width="6" Height="6" Canvas.Left="12" Canvas.Top="11" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="14" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Elephant (Gajah) -->
    <DataTemplate x:Key="Avatar_elephant">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#9CA3AF" Width="10" Height="14" Canvas.Left="3" Canvas.Top="10" />
                <Ellipse Fill="#9CA3AF" Width="10" Height="14" Canvas.Left="21" Canvas.Top="10" />
                <Ellipse Fill="#6B7280" Width="18" Height="17" Canvas.Left="8" Canvas.Top="8" />
                <Path Data="M 17 18 C 17 25 13 28 10 27" Stroke="#6B7280" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="12" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20" Canvas.Top="14" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Otter (Memerang) -->
    <DataTemplate x:Key="Avatar_otter">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#78350F" Width="6" Height="6" Canvas.Left="6" Canvas.Top="8" />
                <Ellipse Fill="#78350F" Width="6" Height="6" Canvas.Left="22" Canvas.Top="8" />
                <Ellipse Fill="#92400E" Width="20" Height="18" Canvas.Left="7" Canvas.Top="9" />
                <Ellipse Fill="#FEF3C7" Width="13" Height="9" Canvas.Left="10.5" Canvas.Top="16" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="21" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="3" Height="2" Canvas.Left="15.5" Canvas.Top="17" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Raccoon (Rakun) -->
    <DataTemplate x:Key="Avatar_raccoon">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="6,13 8,6 13,11" Fill="#4B5563" />
                <Polygon Points="21,11 26,6 28,13" Fill="#4B5563" />
                <Ellipse Fill="#6B7280" Width="22" Height="18" Canvas.Left="6" Canvas.Top="9" />
                <Path Data="M 6 15 C 10 13 14 14 17 18 C 20 14 24 13 28 15 C 27 21 21 21 17 19 C 13 21 7 21 6 15 Z" Fill="#111827" />
                <Ellipse Fill="#FFFFFF" Width="3" Height="3" Canvas.Left="10" Canvas.Top="15" />
                <Ellipse Fill="#FFFFFF" Width="3" Height="3" Canvas.Left="21" Canvas.Top="15" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="11" Canvas.Top="15.5" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="21" Canvas.Top="15.5" />
                <Ellipse Fill="#FEF3C7" Width="8" Height="6" Canvas.Left="13" Canvas.Top="19" />
                <Ellipse Fill="#111827" Width="3" Height="2" Canvas.Left="15.5" Canvas.Top="20" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Zebra (Kuda Belang) -->
    <DataTemplate x:Key="Avatar_zebra">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="8,12 10,4 14,10" Fill="#111827" />
                <Polygon Points="20,10 24,4 26,12" Fill="#111827" />
                <Ellipse Fill="#F8FAFC" Width="18" Height="20" Canvas.Left="8" Canvas.Top="8" />
                <!-- Stripes -->
                <Path Data="M 8 12 L 14 14 M 8 16 L 13 17 M 26 12 L 20 14 M 26 16 L 21 17" Stroke="#111827" StrokeThickness="1.5" />
                <Ellipse Fill="#111827" Width="2.5" Height="2.5" Canvas.Left="12" Canvas.Top="14" />
                <Ellipse Fill="#111827" Width="2.5" Height="2.5" Canvas.Left="20" Canvas.Top="14" />
                <Ellipse Fill="#334155" Width="12" Height="7" Canvas.Left="11" Canvas.Top="20" />
                <Ellipse Fill="#111827" Width="2" Height="2" Canvas.Left="13.5" Canvas.Top="22" />
                <Ellipse Fill="#111827" Width="2" Height="2" Canvas.Left="18.5" Canvas.Top="22" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Ant (Semut) -->
    <DataTemplate x:Key="Avatar_ant">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#8B4513" Width="14" Height="14" Canvas.Left="10" Canvas.Top="11" />
                <Path Data="M 12 11 L 8 5 M 22 11 L 26 5" Stroke="#5C2E0B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="12" Canvas.Top="15" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="19" Canvas.Top="15" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Bison (Bizon) -->
    <DataTemplate x:Key="Avatar_bison">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 7 12 C 4 8 6 3 10 7 M 27 12 C 30 8 28 3 24 7" Stroke="#451A03" StrokeThickness="2.5" StrokeStartLineCap="Round" />
                <Ellipse Fill="#78350F" Width="20" Height="20" Canvas.Left="7" Canvas.Top="7" />
                <Ellipse Fill="#451A03" Width="12" Height="8" Canvas.Left="11" Canvas.Top="18" />
                <Ellipse Fill="#FFFFFF" Width="4" Height="4" Canvas.Left="10" Canvas.Top="13" />
                <Ellipse Fill="#FFFFFF" Width="4" Height="4" Canvas.Left="20" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="11" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="21" Canvas.Top="14" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Chicken (Ayam) -->
    <DataTemplate x:Key="Avatar_chicken">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 13 8 C 13 4 17 4 17 8 C 17 4 21 4 21 8" Fill="#DC2626" />
                <Ellipse Fill="#FFFFFF" Width="20" Height="18" Canvas.Left="7" Canvas.Top="9" />
                <Polygon Points="14,17 20,17 17,23" Fill="#F59E0B" />
                <Ellipse Fill="#DC2626" Width="4" Height="6" Canvas.Left="15" Canvas.Top="22" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20.5" Canvas.Top="14" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Dog (Anjing) -->
    <DataTemplate x:Key="Avatar_dog">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#92400E" Width="8" Height="14" Canvas.Left="4" Canvas.Top="9" />
                <Ellipse Fill="#92400E" Width="8" Height="14" Canvas.Left="22" Canvas.Top="9" />
                <Ellipse Fill="#D97706" Width="20" Height="18" Canvas.Left="7" Canvas.Top="8" />
                <Ellipse Fill="#FEF3C7" Width="12" Height="9" Canvas.Left="11" Canvas.Top="16" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11.5" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="4" Height="3" Canvas.Left="15" Canvas.Top="17.5" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Doraemon -->
    <DataTemplate x:Key="Avatar_doraemon">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#0284C7" Width="22" Height="22" Canvas.Left="6" Canvas.Top="6" />
                <Ellipse Fill="#FFFFFF" Width="18" Height="15" Canvas.Left="8" Canvas.Top="12" />
                <Ellipse Fill="#FFFFFF" Width="6" Height="7" Canvas.Left="11" Canvas.Top="8" />
                <Ellipse Fill="#FFFFFF" Width="6" Height="7" Canvas.Left="17" Canvas.Top="8" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="3" Canvas.Left="13" Canvas.Top="10" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="3" Canvas.Left="18.5" Canvas.Top="10" />
                <Ellipse Fill="#EF4444" Width="4" Height="4" Canvas.Left="15" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Duck (Itik) -->
    <DataTemplate x:Key="Avatar_duck">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#FDE047" Width="20" Height="18" Canvas.Left="7" Canvas.Top="8" />
                <Ellipse Fill="#F97316" Width="14" Height="7" Canvas.Left="10" Canvas.Top="17" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20.5" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Fox (Musang) -->
    <DataTemplate x:Key="Avatar_fox">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="6,12 8,4 14,10" Fill="#EA580C" />
                <Polygon Points="20,10 26,4 28,12" Fill="#EA580C" />
                <Ellipse Fill="#EA580C" Width="22" Height="18" Canvas.Left="6" Canvas.Top="9" />
                <Polygon Points="6,19 17,25 11,15" Fill="#FFFFFF" />
                <Polygon Points="28,19 17,25 23,15" Fill="#FFFFFF" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20.5" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="3" Height="2.5" Canvas.Left="15.5" Canvas.Top="22" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Giraffe (Zirafah) -->
    <DataTemplate x:Key="Avatar_giraffe">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 12 8 L 10 4 M 22 8 L 24 4" Stroke="#78350F" StrokeThickness="2" StrokeStartLineCap="Round" />
                <Ellipse Fill="#FBBF24" Width="18" Height="20" Canvas.Left="8" Canvas.Top="7" />
                <Ellipse Fill="#B45309" Width="4" Height="4" Canvas.Left="10" Canvas.Top="10" />
                <Ellipse Fill="#B45309" Width="4" Height="4" Canvas.Left="20" Canvas.Top="11" />
                <Ellipse Fill="#FEF3C7" Width="12" Height="8" Canvas.Left="11" Canvas.Top="18" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="11" Canvas.Top="14" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="20.5" Canvas.Top="14" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Koala -->
    <DataTemplate x:Key="Avatar_koala">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#9CA3AF" Width="10" Height="10" Canvas.Left="3" Canvas.Top="6" />
                <Ellipse Fill="#9CA3AF" Width="10" Height="10" Canvas.Left="21" Canvas.Top="6" />
                <Ellipse Fill="#E5E7EB" Width="6" Height="6" Canvas.Left="5" Canvas.Top="8" />
                <Ellipse Fill="#E5E7EB" Width="6" Height="6" Canvas.Left="23" Canvas.Top="8" />
                <Ellipse Fill="#6B7280" Width="20" Height="18" Canvas.Left="7" Canvas.Top="9" />
                <Ellipse Fill="#1F2937" Width="6" Height="9" Canvas.Left="14" Canvas.Top="15" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="10.5" Canvas.Top="13" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="21" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Leopard (Harimau Bintang) -->
    <DataTemplate x:Key="Avatar_leopard">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#D97706" Width="6" Height="6" Canvas.Left="6" Canvas.Top="7" />
                <Ellipse Fill="#D97706" Width="6" Height="6" Canvas.Left="22" Canvas.Top="7" />
                <Ellipse Fill="#F59E0B" Width="20" Height="18" Canvas.Left="7" Canvas.Top="8" />
                <!-- Spots -->
                <Ellipse Fill="#78350F" Width="3" Height="3" Canvas.Left="10" Canvas.Top="10" />
                <Ellipse Fill="#78350F" Width="3" Height="3" Canvas.Left="21" Canvas.Top="10" />
                <Ellipse Fill="#78350F" Width="3" Height="2.5" Canvas.Left="15.5" Canvas.Top="9.5" />
                <Ellipse Fill="#FEF3C7" Width="10" Height="7" Canvas.Left="12" Canvas.Top="18" />
