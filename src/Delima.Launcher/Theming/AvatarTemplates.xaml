<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Avatar Vector Templates -->
    <!-- Default / Cat (Kucing) -->
    <DataTemplate x:Key="Avatar_cat">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <!-- Cat head & ears -->
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource PrimaryBrush}" Width="20" Height="20" Canvas.Left="7" Canvas.Top="8" />
                <Polygon Points="8,10 11,2 15,10" Fill="{DynamicResource PrimaryBrush}" />
                <Polygon Points="19,10 23,2 26,10" Fill="{DynamicResource PrimaryBrush}" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="12" Canvas.Top="16" />
                <Ellipse Fill="#1A1208" Width="3" Height="3" Canvas.Left="19" Canvas.Top="16" />
                <Path Data="M 15 21 L 17 23 L 19 21" Stroke="#1A1208" StrokeThickness="1.2" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Fish (Ikan) -->
    <DataTemplate x:Key="Avatar_fish">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource AccentBrush}" Width="18" Height="13" Canvas.Left="6" Canvas.Top="11" />
                <Polygon Points="22,17 30,10 30,24" Fill="{DynamicResource AccentBrush}" />
                <Ellipse Fill="#1A1208" Width="2.5" Height="2.5" Canvas.Left="10" Canvas.Top="15" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Flower (Bunga) -->
    <DataTemplate x:Key="Avatar_flower">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="12.5" Canvas.Top="4" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="21" Canvas.Top="12.5" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="12.5" Canvas.Top="21" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="9" Height="9" Canvas.Left="4" Canvas.Top="12.5" />
                <Ellipse Fill="#FAEEDA" Width="8" Height="8" Canvas.Left="13" Canvas.Top="13" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Car (Kereta) -->
    <DataTemplate x:Key="Avatar_car">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Fill="{DynamicResource ClassColour2}" Width="24" Height="9" RadiusX="3" RadiusY="3" Canvas.Left="5" Canvas.Top="15" />
                <Rectangle Fill="{DynamicResource ClassColour2}" Width="14" Height="8" RadiusX="3" RadiusY="3" Canvas.Left="10" Canvas.Top="9" />
                <Ellipse Fill="#1A1208" Width="6" Height="6" Canvas.Left="9" Canvas.Top="21" />
                <Ellipse Fill="#1A1208" Width="6" Height="6" Canvas.Left="19" Canvas.Top="21" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Star (Bintang) -->
    <DataTemplate x:Key="Avatar_star">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="17,3 20.5,13 31,13 22.5,19.5 26,30 17,23.5 8,30 11.5,19.5 3,13 13.5,13" Fill="{DynamicResource AccentBrush}" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Apple (Epal) -->
    <DataTemplate x:Key="Avatar_apple">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="18" Height="18" Canvas.Left="8" Canvas.Top="11" />
                <Path Data="M 17 11 C 17 7 20 6 21 7" Stroke="#5C5344" StrokeThickness="1.6" />
                <Ellipse Fill="#639922" Width="5" Height="3" Canvas.Left="19" Canvas.Top="7" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Balloon (Belon) -->
    <DataTemplate x:Key="Avatar_balloon">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour1}" Width="16" Height="19" Canvas.Left="9" Canvas.Top="5" />
                <Polygon Points="15,24 19,24 17,27" Fill="{DynamicResource ClassColour1}" />
                <Path Data="M 17 27 L 17 32" Stroke="#5C5344" StrokeThickness="1.4" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Umbrella (Payung) -->
    <DataTemplate x:Key="Avatar_umbrella">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 5 18 A 12 12 0 0 1 29 18 Z" Fill="{DynamicResource ClassColour6}" />
                <Path Data="M 17 18 L 17 28 C 17 31 21 31 21 28" Stroke="#5C5344" StrokeThickness="1.8" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Kite (Layang-layang) -->
    <DataTemplate x:Key="Avatar_kite">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="17,4 27,17 17,30 7,17" Fill="{DynamicResource ClassColour5}" />
                <Line X1="17" Y1="4" X2="17" Y2="30" Stroke="#5C5344" StrokeThickness="1" />
                <Line X1="7" Y1="17" X2="27" Y2="17" Stroke="#5C5344" StrokeThickness="1" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Turtle (Penyu) -->
    <DataTemplate x:Key="Avatar_turtle">
        <Grid Width="36" Height="36">
            <Ellipse Fill="{DynamicResource SoftSurfaceBrush}" Width="36" Height="36" />
            <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource ClassColour5}" Width="18" Height="14" Canvas.Left="7" Canvas.Top="11" />
                <Ellipse Fill="{DynamicResource ClassColour5}" Width="7" Height="7" Canvas.Left="23" Canvas.Top="9" />
                <Ellipse Fill="#1A1208" Width="2" Height="2" Canvas.Left="26" Canvas.Top="11" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- Question Mark (Nama Saya Tiada) -->
    <DataTemplate x:Key="Avatar_missing">
        <Grid Width="36" Height="36">
            <Ellipse Stroke="#C9C4B0" StrokeThickness="2" StrokeDashArray="2 2" Width="34" Height="34" />
            <TextBlock Text="?"
                       FontFamily="{DynamicResource Baloo2Font}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#8A8570"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
