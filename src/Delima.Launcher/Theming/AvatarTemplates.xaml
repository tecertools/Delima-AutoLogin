<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:Delima.Launcher.Theming">

    <!--
        DiceBear Critters Avatar Converter
        Converts a student's avatar seed string into a BitmapImage loaded from
        the DiceBear Critters API (cached locally at %LOCALAPPDATA%\Delima\AvatarCache\).
    -->
    <theming:AvatarSeedToImageConverter x:Key="AvatarConverter" />

</ResourceDictionary>
