<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Picture Password Vector DataTemplates (16 concrete BM-nameable items) -->

    <!-- 1. Bola (Ball) -->
    <DataTemplate x:Key="Picture_bola">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Ball body -->
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="44" Height="44" Canvas.Left="2" Canvas.Top="2" />
                <Ellipse Stroke="#FFFFFF" StrokeThickness="2" Width="44" Height="44" Canvas.Left="2" Canvas.Top="2" />
                <!-- Pattern -->
                <Polygon Points="24,14 31,19 28,28 20,28 17,19" Fill="#FFFFFF" />
                <Line X1="24" Y1="14" X2="24" Y2="3" Stroke="#FFFFFF" StrokeThickness="2" />
                <Line X1="31" Y1="19" X2="42" Y2="14" Stroke="#FFFFFF" StrokeThickness="2" />
                <Line X1="28" Y1="28" X2="36" Y2="40" Stroke="#FFFFFF" StrokeThickness="2" />
                <Line X1="20" Y1="28" X2="12" Y2="40" Stroke="#FFFFFF" StrokeThickness="2" />
                <Line X1="17" Y1="19" X2="6" Y2="14" Stroke="#FFFFFF" StrokeThickness="2" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 2. Buku (Book) -->
    <DataTemplate x:Key="Picture_buku">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Book Cover Left -->
                <Path Data="M 24 10 C 18 8 10 9 6 11 L 6 37 C 10 35 18 34 24 36 Z" Fill="{DynamicResource ClassColour6}" />
                <!-- Book Cover Right -->
                <Path Data="M 24 10 C 30 8 38 9 42 11 L 42 37 C 38 35 30 34 24 36 Z" Fill="{DynamicResource ClassColour6}" />
                <!-- Inner Pages -->
                <Path Data="M 24 12 C 19 10 12 11 8 13 L 8 35 C 12 33 19 32 24 34 Z" Fill="#FFFFFF" />
                <Path Data="M 24 12 C 29 10 36 11 40 13 L 40 35 C 36 33 29 32 24 34 Z" Fill="#FFFFFF" />
                <!-- Spine -->
                <Line X1="24" Y1="10" X2="24" Y2="37" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.5" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 3. Bintang (Star) -->
    <DataTemplate x:Key="Picture_bintang">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <Polygon Points="24,4 29.5,17.5 44,17.5 32.5,26.5 37,40.5 24,32 11,40.5 15.5,26.5 4,17.5 18.5,17.5"
                         Fill="{DynamicResource AccentBrush}"
                         Stroke="{DynamicResource PrimaryTextBrush}"
                         StrokeThickness="1.5" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 4. Pokok (Tree) -->
    <DataTemplate x:Key="Picture_pokok">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Trunk -->
                <Rectangle Fill="{DynamicResource ClassColour7}" Width="10" Height="18" RadiusX="2" RadiusY="2" Canvas.Left="19" Canvas.Top="26" />
                <!-- Leaves Layer 1 -->
                <Ellipse Fill="{DynamicResource PrimaryBrush}" Width="36" Height="26" Canvas.Left="6" Canvas.Top="12" />
                <!-- Leaves Layer 2 Top -->
                <Ellipse Fill="{DynamicResource ClassColour5}" Width="28" Height="22" Canvas.Left="10" Canvas.Top="4" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 5. Kereta (Car) -->
    <DataTemplate x:Key="Picture_kereta">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Car Body -->
                <Rectangle Fill="{DynamicResource ClassColour2}" Width="40" Height="14" RadiusX="4" RadiusY="4" Canvas.Left="4" Canvas.Top="22" />
                <!-- Cabin -->
                <Path Data="M 12 22 L 18 12 L 32 12 L 38 22 Z" Fill="{DynamicResource ClassColour2}" />
                <!-- Windows -->
                <Path Data="M 19 21 L 19 14 L 23 14 L 23 21 Z" Fill="#FFFFFF" />
                <Path Data="M 26 21 L 26 14 L 31 14 L 33 21 Z" Fill="#FFFFFF" />
                <!-- Wheels -->
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Canvas.Left="10" Canvas.Top="30" />
                <Ellipse Fill="#FFFFFF" Width="4" Height="4" Canvas.Left="13" Canvas.Top="33" />
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Canvas.Left="28" Canvas.Top="30" />
                <Ellipse Fill="#FFFFFF" Width="4" Height="4" Canvas.Left="31" Canvas.Top="33" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 6. Rumah (House) -->
    <DataTemplate x:Key="Picture_rumah">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Roof -->
                <Polygon Points="24,6 42,20 6,20" Fill="{DynamicResource ClassColour0}" />
                <!-- Walls -->
                <Rectangle Fill="{DynamicResource ClassColour3}" Width="30" Height="22" RadiusX="2" RadiusY="2" Canvas.Left="9" Canvas.Top="20" />
                <!-- Door -->
                <Rectangle Fill="{DynamicResource ClassColour7}" Width="9" Height="14" RadiusX="2" RadiusY="2" Canvas.Left="19.5" Canvas.Top="28" />
                <!-- Window -->
                <Rectangle Fill="#FFFFFF" Width="6" Height="6" RadiusX="1" RadiusY="1" Canvas.Left="12" Canvas.Top="23" />
                <Rectangle Fill="#FFFFFF" Width="6" Height="6" RadiusX="1" RadiusY="1" Canvas.Left="30" Canvas.Top="23" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 7. Ikan (Fish) -->
    <DataTemplate x:Key="Picture_ikan">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Tail -->
                <Polygon Points="34,24 44,14 44,34" Fill="{DynamicResource AccentBrush}" />
                <!-- Body -->
                <Ellipse Fill="{DynamicResource AccentBrush}" Width="32" Height="22" Canvas.Left="6" Canvas.Top="13" />
                <!-- Eye -->
                <Ellipse Fill="#FFFFFF" Width="6" Height="6" Canvas.Left="12" Canvas.Top="18" />
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="3" Height="3" Canvas.Left="13" Canvas.Top="19" />
                <!-- Fin -->
                <Path Data="M 22 24 C 20 28 16 30 14 27 Z" Fill="{DynamicResource ClassColour1}" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 8. Kucing (Cat) -->
    <DataTemplate x:Key="Picture_kucing">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Ears -->
                <Polygon Points="10,18 14,6 20,18" Fill="{DynamicResource PrimaryBrush}" />
                <Polygon Points="28,18 34,6 38,18" Fill="{DynamicResource PrimaryBrush}" />
                <Polygon Points="12,17 14,9 18,17" Fill="#FFAAAA" />
                <Polygon Points="30,17 34,9 36,17" Fill="#FFAAAA" />
                <!-- Head -->
                <Ellipse Fill="{DynamicResource PrimaryBrush}" Width="32" Height="28" Canvas.Left="8" Canvas.Top="14" />
                <!-- Eyes -->
                <Ellipse Fill="#FFFFFF" Width="7" Height="7" Canvas.Left="14" Canvas.Top="22" />
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="4" Height="4" Canvas.Left="16" Canvas.Top="24" />
                <Ellipse Fill="#FFFFFF" Width="7" Height="7" Canvas.Left="27" Canvas.Top="22" />
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="4" Height="4" Canvas.Left="28" Canvas.Top="24" />
                <!-- Nose & Mouth -->
                <Polygon Points="24,31 22,29 26,29" Fill="#FFAAAA" />
                <Path Data="M 21 33 Q 24 36 27 33" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 9. Bunga (Flower) -->
    <DataTemplate x:Key="Picture_bunga">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Petals -->
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="16" Height="16" Canvas.Left="16" Canvas.Top="4" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="16" Height="16" Canvas.Left="28" Canvas.Top="16" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="16" Height="16" Canvas.Left="16" Canvas.Top="28" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="16" Height="16" Canvas.Left="4" Canvas.Top="16" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="14" Height="14" Canvas.Left="8" Canvas.Top="8" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="14" Height="14" Canvas.Left="26" Canvas.Top="8" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="14" Height="14" Canvas.Left="8" Canvas.Top="26" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="14" Height="14" Canvas.Left="26" Canvas.Top="26" />
                <!-- Center -->
                <Ellipse Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Canvas.Left="16" Canvas.Top="16" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 10. Epal (Apple) -->
    <DataTemplate x:Key="Picture_epal">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Body -->
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="19" Height="26" Canvas.Left="9" Canvas.Top="14" />
                <Ellipse Fill="{DynamicResource ClassColour0}" Width="19" Height="26" Canvas.Left="20" Canvas.Top="14" />
                <!-- Stem -->
                <Path Data="M 24 15 C 24 9 27 6 29 7" Stroke="{DynamicResource ClassColour7}" StrokeThickness="2.5" />
                <!-- Leaf -->
                <Ellipse Fill="{DynamicResource PrimaryBrush}" Width="8" Height="5" Canvas.Left="27" Canvas.Top="7" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 11. Pisang (Banana) -->
    <DataTemplate x:Key="Picture_pisang">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Banana curve -->
                <Path Data="M 10 14 C 18 36 34 38 40 32 C 34 42 12 36 8 18 Z"
                      Fill="{DynamicResource AccentBrush}" />
                <!-- Stem tips -->
                <Rectangle Fill="{DynamicResource ClassColour7}" Width="4" Height="4" Canvas.Left="7" Canvas.Top="15" />
                <Rectangle Fill="{DynamicResource ClassColour7}" Width="3" Height="3" Canvas.Left="39" Canvas.Top="32" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 12. Payung (Umbrella) -->
    <DataTemplate x:Key="Picture_payung">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Canopy -->
                <Path Data="M 6 26 A 18 18 0 0 1 42 26 Z" Fill="{DynamicResource ClassColour6}" />
                <Line X1="24" Y1="8" X2="24" Y2="5" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" />
                <!-- Handle -->
                <Path Data="M 24 26 L 24 38 C 24 42 30 42 30 38" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.5" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 13. Belon (Balloon) -->
    <DataTemplate x:Key="Picture_belon">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Balloon -->
                <Ellipse Fill="{DynamicResource ClassColour1}" Width="26" Height="30" Canvas.Left="11" Canvas.Top="6" />
                <Polygon Points="21,35 27,35 24,39" Fill="{DynamicResource ClassColour1}" />
                <!-- String -->
                <Path Data="M 24 39 Q 20 42 24 46" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="2" />
                <!-- Shine -->
                <Ellipse Fill="#FFFFFF" Width="5" Height="9" Canvas.Left="15" Canvas.Top="11" Opacity="0.6" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 14. Jam (Clock) -->
    <DataTemplate x:Key="Picture_jam">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Outer Frame -->
                <Ellipse Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3.5" Width="38" Height="38" Canvas.Left="5" Canvas.Top="5" />
                <!-- Center Dot -->
                <Ellipse Fill="{DynamicResource PrimaryTextBrush}" Width="4" Height="4" Canvas.Left="22" Canvas.Top="22" />
                <!-- Hour hand (at 3) -->
                <Line X1="24" Y1="24" X2="32" Y2="24" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.5" />
                <!-- Minute hand (at 12) -->
                <Line X1="24" Y1="24" X2="24" Y2="12" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 15. Pensel (Pencil) -->
    <DataTemplate x:Key="Picture_pensel">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Body -->
                <Rectangle Fill="{DynamicResource AccentBrush}" Width="26" Height="10" RadiusX="1" RadiusY="1" Canvas.Left="12" Canvas.Top="19">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-45" CenterX="13" CenterY="5" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- Eraser -->
                <Rectangle Fill="#FFAAAA" Width="8" Height="10" RadiusX="2" RadiusY="2" Canvas.Left="30" Canvas.Top="7">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-45" CenterX="4" CenterY="5" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- Tip -->
                <Polygon Points="10,34 16,40 6,42" Fill="{DynamicResource ClassColour7}" />
                <Polygon Points="8,39 10,41 6,42" Fill="{DynamicResource PrimaryTextBrush}" />
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- 16. Topi (Cap) -->
    <DataTemplate x:Key="Picture_topi">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
                <!-- Crown / Dome -->
                <Path Data="M 12 28 A 15 15 0 0 1 38 28 Z" Fill="{DynamicResource ClassColour0}" />
                <!-- Visor / Peak -->
                <Path Data="M 12 28 C 4 28 2 34 6 35 C 16 35 34 32 38 28 Z" Fill="{DynamicResource ClassColour0}" />
                <!-- Button on top -->
                <Ellipse Fill="{DynamicResource AccentBrush}" Width="4" Height="4" Canvas.Left="23" Canvas.Top="12" />
            </Canvas>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
