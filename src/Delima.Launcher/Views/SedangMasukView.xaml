<UserControl x:Class="Delima.Launcher.Views.SedangMasukView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SedangMasukViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <Grid>
        <!-- Centered Card Container (Max Width 520px, 20px Radius) -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Width="520"
                Padding="40,48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Avatar / Icon Placeholder -->
                <Border Width="96" Height="96"
                        CornerRadius="48"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="3"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <TextBlock Text="🚀"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Pupil Name -->
                <TextBlock Text="{Binding Student.DisplayName}"
                           Style="{DynamicResource ScreenHeadingStyle}"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{DynamicResource HelperTextStyle}"
                           FontSize="18"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           Margin="0,0,0,32" />

                <!-- Progress Indicator Bar -->
                <ProgressBar IsIndeterminate="{Binding IsBusy}"
                             Height="8"
                             Width="380"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource SoftSurfaceBrush}"
                             BorderThickness="0"
                             Margin="0,0,0,40" />

                <!-- Cancel Button (Batal) -->
                <Button Content="Batal"
                        Command="{Binding CancelCommand}"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource AlertBrush}"
                        BorderBrush="{DynamicResource AlertBrush}"
                        BorderThickness="2"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="32,12"
                        HorizontalAlignment="Center"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
