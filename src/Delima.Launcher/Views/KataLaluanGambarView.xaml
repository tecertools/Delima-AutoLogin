<UserControl x:Class="Delima.Launcher.Views.KataLaluanGambarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             xmlns:theming="clr-namespace:Delima.Launcher.Theming"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:KataLaluanGambarViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <theming:PicturePasswordTemplateSelector x:Key="PictureSelector" />

        <!-- Icon Tile Button Style (16px CornerRadius, Soft Surface, Shadow, >=48px target) -->
        <Style x:Key="PicturePasswordTileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualDefault}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBorder" Property="Background" Value="#F5ECC0" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for Icon Grid Tile -->
        <DataTemplate DataType="{x:Type vm:PicturePasswordIconViewModel}">
            <Button Style="{StaticResource PicturePasswordTileButtonStyle}"
                    Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Vector Icon Drawing -->
                    <ContentControl Grid.Row="0"
                                    Content="{Binding Id}"
                                    ContentTemplateSelector="{StaticResource PictureSelector}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,4" />

                    <!-- BM Label -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               FontFamily="{DynamicResource NunitoFont}"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar (68px) -->
            <RowDefinition Height="68" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer (44px) -->
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- TOPBAR (Compact 68px header with Kembali, Class Pill, and Crest) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Kembali Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource BackButtonStyle}"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="Kembali ke carian nama">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◂ "
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Kembali"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Center: Class Pill -->
                <Border Grid.Column="1"
                        Background="{Binding ClassColourBrush}"
                        CornerRadius="999"
                        Padding="24,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ClassName, StringFormat='Kelas {0}'}">
                    <TextBlock Text="{Binding ClassName}"
                               Foreground="#FFFFFF"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Right: Compact School Crest -->
                <Border Grid.Column="2"
                        Width="36" Height="36"
                        CornerRadius="10"
                        Background="{DynamicResource AccentBrush}"
                        AutomationProperties.Name="Lencana Sekolah">
                    <TextBlock Text="{Binding SchoolCode}"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="24,12,24,6">
            <Grid.RowDefinitions>
                <!-- Title & Subtitle & Dots -->
                <RowDefinition Height="Auto" />
                <!-- 16-Icon Grid -->
                <RowDefinition Height="*" />
                <!-- Attempts / Lockout Notice -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Headings and 3 Progress Dots -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                <!-- Heading -->
                <TextBlock Text="Pilih Gambar Anda"
                           Style="{StaticResource ScreenHeadingStyle}"
                           FontSize="24"
                           TextAlignment="Center"
                           Margin="0,0,0,4" />

                <!-- Subtitle with Pupil Name -->
                <TextBlock Text="{Binding PupilDisplayName, StringFormat='Hai {0}, sentuh 3 gambar mengikut turutan yang betul.'}"
                           Style="{StaticResource HelperTextStyle}"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- 3 Sequence Progress Dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <!-- Dot 1 -->
                    <Border Width="18" Height="18" CornerRadius="9" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot1Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Dot 2 -->
                    <Border Width="18" Height="18" CornerRadius="9" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot2Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Dot 3 -->
                    <Border Width="18" Height="18" CornerRadius="9" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot3Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <!-- Error / Status Message Feedback -->
                <Border Background="#FCE8E6"
                        BorderBrush="#ED1B24"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,6"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#C41118"
                               FontWeight="Bold"
                               FontSize="13"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Lockout Banner -->
                <Border Background="#FAEEDA"
                        BorderBrush="#854F0B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,10"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠ "
                                   Foreground="#854F0B"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockoutMessage}"
                                   Foreground="#854F0B"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Border Background="#854F0B" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LockoutTimeRemainingText}"
                                       Foreground="#FFFFFF"
                                       FontWeight="Bold"
                                       FontSize="13" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 16-Icon Grid (8 columns x 2 rows, Instant non-animated CSPRNG shuffle) -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="840">
                <ItemsControl ItemsSource="{Binding ShuffledIcons}"
                              IsEnabled="{Binding IsLockedOut, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                              Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <!-- Attempts Counter & Clear button -->
            <Grid Grid.Row="2" Margin="0,8,0,0" MaxWidth="840" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Attempts Remaining Text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding AttemptsRemainingText}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <!-- Padam / Semula Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        MinHeight="36"
                        Padding="14,4"
                        Command="{Binding ClearSelectionCommand}"
                        Content="Padam Pilihan"
                        AutomationProperties.Name="Padam pilihan gambar"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdatedDateText}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="Masalah? Panggil cikgu."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
