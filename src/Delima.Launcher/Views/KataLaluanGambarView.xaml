<UserControl x:Class="Delima.Launcher.Views.KataLaluanGambarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             xmlns:theming="clr-namespace:Delima.Launcher.Theming"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:KataLaluanGambarViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <theming:PicturePasswordTemplateSelector x:Key="PictureSelector" />

        <!-- Icon Tile Button Style (Windows 11 Fluent Tile with Micro-interactions) -->
        <Style x:Key="PicturePasswordTileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualDefault}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="6"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="tileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="tileBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.10" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBorder" Property="Background" Value="#F5ECC0" />
                                <Setter TargetName="tileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for Icon Grid Tile -->
        <DataTemplate DataType="{x:Type vm:PicturePasswordIconViewModel}">
            <Button Style="{StaticResource PicturePasswordTileButtonStyle}"
                    Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Vector Icon Drawing -->
                    <ContentControl Grid.Row="0"
                                    Content="{Binding Id}"
                                    ContentTemplateSelector="{StaticResource PictureSelector}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,4" />

                    <!-- Label -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               FontFamily="{DynamicResource NunitoFont}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar (64px) -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer (40px) -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- TOPBAR (Windows 11 Surface Header) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Kembali Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource BackButtonStyle}"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="Kembali ke carian nama">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="← "
                                   FontWeight="Bold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Kembali"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Center: Class Pill -->
                <Border Grid.Column="1"
                        Background="{Binding ClassColourBrush}"
                        CornerRadius="6"
                        Padding="20,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ClassName, StringFormat='Kelas {0}'}">
                    <TextBlock Text="{Binding ClassName}"
                               Foreground="#FFFFFF"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Right: Compact School Crest -->
                <Border Grid.Column="2"
                        Width="34" Height="34"
                        CornerRadius="6"
                        Background="{DynamicResource PrimaryBrush}"
                        AutomationProperties.Name="Lencana Sekolah">
                    <TextBlock Text="{Binding SchoolCode}"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,12,24,6" MaxWidth="880" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <!-- Title & Subtitle & Dots -->
                    <RowDefinition Height="Auto" />
                    <!-- 16-Icon Grid -->
                    <RowDefinition Height="*" />
                    <!-- Attempts / Lockout Notice -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Headings and 3 Progress Dots with Windows 11 Shake Animation -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HeaderShakeTransform" X="0" Y="0" />
                </StackPanel.RenderTransform>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.04" Value="-10" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="10" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="-8" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="8" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="-4" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="4" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Heading -->
                <TextBlock Text="Pilih Kata Laluan Gambar"
                           Style="{StaticResource ScreenHeadingStyle}"
                           FontSize="22"
                           TextAlignment="Center"
                           Margin="0,0,0,4" />

                <!-- Subtitle with Pupil Name -->
                <TextBlock Text="{Binding PupilDisplayName, StringFormat='Hai {0}, sentuh 3 gambar mengikut turutan yang betul.'}"
                           Style="{StaticResource HelperTextStyle}"
                           FontSize="13.5"
                           TextAlignment="Center"
                           Margin="0,0,0,10" />

                <!-- 3 Sequence Progress Dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <!-- Dot 1 -->
                    <Border Width="20" Height="20" CornerRadius="10" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot1Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Dot 2 -->
                    <Border Width="20" Height="20" CornerRadius="10" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot2Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Dot 3 -->
                    <Border Width="20" Height="20" CornerRadius="10" Margin="6,0"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dot3Filled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <!-- Error / Status Message Feedback (WinUI 3 InfoBar Error) -->
                <Border Background="#FDE7E9"
                        BorderBrush="#ED1B24"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,6"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#A80000"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Lockout Banner (WinUI 3 InfoBar Warning) -->
                <Border Background="#FFF4CE"
                        BorderBrush="#797673"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18,8"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️ "
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LockoutMessage}"
                                   Foreground="#4C4A48"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="4,0,12,0" />
                        <Border Background="#797673" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LockoutTimeRemainingText}"
                                       Foreground="#FFFFFF"
                                       FontWeight="Bold"
                                       FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 16-Icon Grid (8 columns x 2 rows) -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="840">
                <ItemsControl ItemsSource="{Binding ShuffledIcons}"
                              Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <!-- Attempts Counter & Clear button -->
            <Grid Grid.Row="2" Margin="0,8,0,0" MaxWidth="840" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Attempts Remaining Text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding AttemptsRemainingText}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <!-- Padam / Semula Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        MinHeight="34"
                        Padding="12,4"
                        Command="{Binding ClearSelectionCommand}"
                        Content="Padam Pilihan"
                        AutomationProperties.Name="Padam pilihan gambar"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdatedDateText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="tecertools Digital Solutions"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.65"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Masalah log masuk? Sila maklumkan kepada guru bertugas."
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
