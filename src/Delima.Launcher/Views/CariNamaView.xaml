<UserControl x:Class="Delima.Launcher.Views.CariNamaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             xmlns:theming="clr-namespace:Delima.Launcher.Theming"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PupilCardViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <!-- DiceBear Critter image converter (seed → BitmapImage) -->
        <theming:AvatarSeedToImageConverter x:Key="AvatarConverter" />

        <!-- DataTemplate for Pupil Cards in Grid -->
        <DataTemplate DataType="{x:Type vm:PupilCardViewModel}">
            <!-- Normal Pupil Card -->
            <Button Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    Margin="4">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PupilCardButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissingEscapeCard}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="missingBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="6,8"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="missingBorder" Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
                                                    <Setter TargetName="missingBorder" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Setter TargetName="missingBorder" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="missingBorder" Property="Background" Value="#F5ECC0" />
                                                    <Setter TargetName="missingBorder" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="missingBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- DiceBear Critter Avatar -->
                    <Border Grid.Row="0"
                            Width="52" Height="52" CornerRadius="26"
                            Background="{DynamicResource SoftSurfaceBrush}"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <Image Source="{Binding AvatarKey, Converter={StaticResource AvatarConverter}}"
                               Width="52" Height="52"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Pupil Name Label (Max 2 lines) -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayName}"
                               FontFamily="{DynamicResource NunitoFont}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="16"
                               MaxHeight="36"
                               HorizontalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar (64px) -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer (40px) -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- TOPBAR (Windows 11 Surface Bar) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Kembali Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource BackButtonStyle}"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="Kembali ke pemilihan kelas">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="← "
                                   FontWeight="Bold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Kembali"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Center: Class Pill -->
                <Border Grid.Column="1"
                        Background="{Binding ClassColourBrush}"
                        CornerRadius="6"
                        Padding="20,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ClassName, StringFormat='Kelas {0}'}">
                    <TextBlock Text="{Binding ClassName}"
                               Foreground="#FFFFFF"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Right: Compact School Crest -->
                <Border Grid.Column="2"
                        Width="34" Height="34"
                        CornerRadius="6"
                        Background="{DynamicResource PrimaryBrush}"
                        AutomationProperties.Name="Lencana Sekolah">
                    <TextBlock Text="{Binding SchoolCode}"
                               FontFamily="{DynamicResource Baloo2Font}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY: Heading, Search Box, and Adaptive Grid -->
        <Grid Grid.Row="1" Margin="24,14,24,10">
            <Grid.RowDefinitions>
                <!-- Title & Search (Auto) -->
                <RowDefinition Height="Auto" />
                <!-- Grid Area (*) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Heading & Search Row -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="Cari Nama Anda"
                           Style="{StaticResource ScreenHeadingStyle}"
                           FontSize="22"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Search Input with Clear Button -->
                <Grid Width="350" HorizontalAlignment="Center">
                    <TextBox Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="🔍 Taip nama murid…"
                             Padding="14,10,36,10"
                             AutomationProperties.Name="Carian nama murid" />
                    <Button Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisConverter}}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Width="24" Height="24"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ToolTip="Padam carian">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E0E0E0" CornerRadius="12">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#6E6E6E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#CCCCCC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Adaptive Card Grid (UniformGrid with computed ColumnCount) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding FilteredPupilCards}"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdatedDateText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="tecertools Digital Solutions"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.65"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Masalah log masuk? Sila maklumkan kepada guru bertugas."
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
