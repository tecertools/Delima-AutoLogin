<Window x:Class="Delima.Launcher.Views.FloatingResetBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DELIMa Floating Reset Bar"
        Height="62" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5"
            CornerRadius="18"
            Margin="4"
            Effect="{DynamicResource CardShadow}"
            Padding="14,6">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pupil Display Information -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                <Border Width="34" Height="34"
                        CornerRadius="17"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="2"
                        Margin="0,0,10,0">
                    <TextBlock Text="👤"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PupilNameText"
                               Text="Nama Murid"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                    <TextBlock Text="DELIMa 3.0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Red Logout / Reset Button (Selesai — Murid seterusnya) -->
            <Button x:Name="LogoutButton"
                    Grid.Column="1"
                    Click="OnLogoutClicked"
                    Background="{DynamicResource AlertBrush}"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Padding="16,6"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚪 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Selesai"
                                   FontSize="13"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Left"
                                   LineHeight="14" />
                        <TextBlock Text="Murid seterusnya"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Opacity="0.9"
                                   HorizontalAlignment="Left"
                                   LineHeight="12" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
