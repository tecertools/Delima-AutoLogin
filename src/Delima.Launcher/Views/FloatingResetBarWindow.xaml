<ui:FluentWindow x:Class="Delima.Launcher.Views.FloatingResetBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="DELIMa Floating Reset Bar"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowBackdropType="None"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <!-- Windows 11 Acrylic-Style Floating Pill -->
    <Border x:Name="MainBorder"
            Background="#FDFDFDEE"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="6"
            Effect="{DynamicResource PopupShadow}"
            Padding="12,8"
            MouseLeftButtonDown="OnBarMouseLeftButtonDown"
            Cursor="SizeAll"
            ToolTip="Tarik untuk alihkan kedudukan bar ini">

        <StackPanel x:Name="BarStackPanel">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pupil Display Information -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Border x:Name="AvatarBorder"
                            Width="32" Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource SoftSurfaceBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            ClipToBounds="True"
                            Margin="0,0,8,0">
                        <Grid>
                            <TextBlock x:Name="AvatarFallbackText"
                                       Text="🐾"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="AvatarImage"
                                   Width="32" Height="32"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PupilNameText"
                                   Text="Nama Murid"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="DELIMa 3.0"
                                   FontSize="10.5"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Red Logout / Reset Button (WinUI 3 Critical Action Button) -->
                <Button x:Name="LogoutButton"
                        Grid.Column="1"
                        Click="OnLogoutClicked"
                        Background="{DynamicResource AlertBrush}"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="14,6"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="4,0">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚪 " FontSize="12" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock x:Name="LogoutText"
                                   Text="Selesai"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Collapse / Expand Toggle Button -->
                <Button x:Name="ToggleCollapseButton"
                        Grid.Column="2"
                        Click="OnToggleCollapseClicked"
                        Background="#F1F3F5"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Width="28" Height="28"
                        Padding="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Kecilkan / Besarkan bar">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="14" />
                        </Style>
                    </Button.Resources>
                    <TextBlock x:Name="ToggleIcon"
                               Text="▲"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- OAuth Consent Identity Verification Prompt Line -->
            <Border x:Name="ConsentPromptBorder"
                    Background="#F0F6FF"
                    BorderBrush="#BEE3F8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="4,8,4,2"
                    Padding="10,6"
                    Visibility="Visible">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="👉 " FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="ConsentPromptText"
                               Text="Lihat nama kamu. Kalau betul, tekan butang biru di bawah."
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#005FB8"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</ui:FluentWindow>
