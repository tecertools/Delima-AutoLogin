<UserControl x:Class="Delima.Launcher.Views.PilihKelasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             xmlns:roster="clr-namespace:Delima.Core.Roster;assembly=Delima.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PilihKelasViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (78px) -->
            <RowDefinition Height="78" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Footer (44px) -->
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AlertBrush}"
                BorderThickness="0,0,0,3"
                Padding="32,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: School Crest + Name + Motto -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,14,0"
                            AutomationProperties.Name="Lencana Sekolah">
                        <TextBlock Text="{Binding SchoolCode}"
                                   FontFamily="{DynamicResource Baloo2Font}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SchoolName}"
                                   FontFamily="{DynamicResource Baloo2Font}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding SchoolMotto}"
                                   FontFamily="{DynamicResource NunitoFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: BM/EN toggle + Guru button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Segmented Toggle -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Height="44"
                            Margin="0,0,12,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleLanguageCommand}"
                                BorderThickness="0"
                                Padding="14,0"
                                Height="42"
                                AutomationProperties.Name="Pilih bahasa BM atau EN">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="999"
                                        Padding="10,4"
                                        Margin="0,0,4,0">
                                    <TextBlock Text="BM"
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               FontSize="12" />
                                </Border>
                                <TextBlock Text="EN"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Guru Button -->
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding OpenTeacherModeCommand}"
                            Content="Guru"
                            TabIndex="10"
                            AutomationProperties.Name="Buka Mod Guru" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: 2 COLUMNS (Left 45%, Right 55%) -->
        <Grid Grid.Row="1" Margin="32,24,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="380" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="1.1*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Selection Form -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Pilih Kelas Anda"
                               Style="{StaticResource ScreenHeadingStyle}"
                               Margin="0,0,0,16" />

                    <!-- Kelas Terakhir Shortcut Card (if available) -->
                    <StackPanel Visibility="{Binding HasLastClass, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,14">
                        <TextBlock Text="Kelas Terakhir"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Button Style="{StaticResource KelasTerakhirButtonStyle}"
                                Background="{DynamicResource ClassColour0}"
                                Command="{Binding SelectLastClassCommand}"
                                TabIndex="1"
                                AutomationProperties.Name="{Binding LastClassDisplayText, StringFormat='Pilih Kelas Terakhir {0}'}">
                            <TextBlock Text="{Binding LastClassDisplayText}" />
                        </Button>
                        <Rectangle Height="1"
                                   Fill="{DynamicResource BorderBrush}"
                                   Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Tahun Dropdown -->
                    <TextBlock Text="Tahun"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Style="{StaticResource LargeComboBoxStyle}"
                              ItemsSource="{Binding AvailableTahun}"
                              SelectedItem="{Binding SelectedTahun}"
                              TabIndex="2"
                              AutomationProperties.Name="Pilih Tahun">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='Tahun {0}'}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Kelas Dropdown -->
                    <TextBlock Text="Kelas"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,14,0,6" />
                    <ComboBox Style="{StaticResource LargeComboBoxStyle}"
                              ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClass}"
                              IsEnabled="{Binding IsKelasDropdownEnabled}"
                              TabIndex="3"
                              AutomationProperties.Name="Pilih Kelas">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type roster:ClassInfo}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="18" Height="18"
                                             Fill="{DynamicResource ClassColour0}"
                                             Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Teruskan Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ProceedCommand}"
                            IsEnabled="{Binding CanProceed}"
                            Content="Teruskan →"
                            TabIndex="4"
                            Margin="0,18,0,0"
                            AutomationProperties.Name="Teruskan ke senarai nama murid" />
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Information Panel for Adults -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    CornerRadius="20"
                    Padding="32,28"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource CardShadow}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Apa itu laman ini?"
                               Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Masuk ke DELIMa dan Google Classroom tanpa perlu menaip alamat e-mel yang panjang."
                               Style="{StaticResource HelperTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <!-- 3 Numbered Steps -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="28" Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="1"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pilih kelas anda"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="28" Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="2"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Cari nama anda"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="28" Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="3"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pilih DELIMa atau Google Classroom"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Reassurance Block -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="4,0,0,0"
                            CornerRadius="0,12,12,0"
                            Padding="16,12"
                            Margin="0,0,0,18">
                        <TextBlock Text="Laman ini tidak menyimpan kata laluan. Anda akan menaip kata laluan di halaman rasmi Google."
                                   Style="{StaticResource HelperTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Destination Chips Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <TextBlock Text="DELIMa 3.0"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <TextBlock Text="Classroom"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdatedDateText}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="Masalah? Panggil cikgu."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
