<UserControl x:Class="Delima.Launcher.Views.PilihKelasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Delima.Launcher.ViewModels"
             xmlns:roster="clr-namespace:Delima.Core.Roster;assembly=Delima.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PilihKelasViewModel}"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (72px) -->
            <RowDefinition Height="72" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Footer (40px) -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- HEADER (Windows 11 Surface Header) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: School Badge + Name + Motto -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42"
                            CornerRadius="8"
                            Background="{DynamicResource PrimaryBrush}"
                            Margin="0,0,14,0"
                            AutomationProperties.Name="Lencana Sekolah">
                        <TextBlock Text="{Binding SchoolCode}"
                                   FontFamily="{DynamicResource Baloo2Font}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SchoolName}"
                                   FontFamily="{DynamicResource Baloo2Font}"
                                   FontWeight="SemiBold"
                                   FontSize="17"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding SchoolMotto}"
                                   FontFamily="{DynamicResource NunitoFont}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: BM/EN toggle + Guru button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Segmented Toggle -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="38"
                            Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleLanguageCommand}"
                                BorderThickness="0"
                                Padding="12,0"
                                Height="36"
                                AutomationProperties.Name="Pilih bahasa BM atau EN">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Margin="0,0,4,0">
                                    <TextBlock Text="BM"
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               FontSize="11.5" />
                                </Border>
                                <TextBlock Text="EN"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Guru Button -->
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding OpenTeacherModeCommand}"
                            Content="⚙️ Mod Guru"
                            TabIndex="10"
                            AutomationProperties.Name="Buka Mod Guru" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: 2 COLUMNS (Left 45%, Right 55%) -->
        <Grid Grid.Row="1" Margin="32,24,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.88*" MinWidth="380" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="1.12*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Selection Form -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Pilih Kelas Anda"
                               Style="{StaticResource ScreenHeadingStyle}"
                               Margin="0,0,0,16" />

                    <!-- Kelas Terakhir Shortcut Card (if available) -->
                    <StackPanel Visibility="{Binding HasLastClass, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,14">
                        <TextBlock Text="Kelas Terakhir Digunakan"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Button Style="{StaticResource KelasTerakhirButtonStyle}"
                                Background="{DynamicResource ClassColour0}"
                                Command="{Binding SelectLastClassCommand}"
                                TabIndex="1"
                                AutomationProperties.Name="{Binding LastClassDisplayText, StringFormat='Pilih Kelas Terakhir {0}'}">
                            <TextBlock Text="{Binding LastClassDisplayText}" />
                        </Button>
                        <Rectangle Height="1"
                                   Fill="{DynamicResource BorderBrush}"
                                   Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Tahun Dropdown -->
                    <TextBlock Text="Tahun"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource LargeComboBoxStyle}"
                              ItemsSource="{Binding AvailableTahun}"
                              SelectedItem="{Binding SelectedTahun}"
                              TabIndex="2"
                              Margin="0,0,0,16"
                              AutomationProperties.Name="Pilih Tahun">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='Tahun {0}'}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Kelas Dropdown -->
                    <TextBlock Text="Kelas"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource LargeComboBoxStyle}"
                              ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClass}"
                              IsEnabled="{Binding IsKelasDropdownEnabled}"
                              TabIndex="3"
                              Margin="0,0,0,20"
                              AutomationProperties.Name="Pilih Kelas">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type roster:ClassInfo}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{DynamicResource ClassColour0}"
                                             Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Teruskan Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ProceedCommand}"
                            IsEnabled="{Binding CanProceed}"
                            Content="Teruskan →"
                            TabIndex="4"
                            Margin="0,18,0,0"
                            AutomationProperties.Name="Teruskan ke senarai nama murid" />
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Information Panel (Windows 11 Layered Card) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32,28"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource CardShadow}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panduan Pelancar Makmal"
                               Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Masuk ke DELIMa dan Google Classroom tanpa perlu menaip alamat e-mel yang panjang."
                               Style="{StaticResource HelperTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <!-- 3 Numbered Steps -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="24" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="1"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pilih tahun dan nama kelas anda"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="24" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="2"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Cari dan tekan kad nama anda"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="24" Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="3"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pilih DELIMa atau Google Classroom"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Reassurance InfoBar -->
                    <Border Background="#F4FAF6"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="0,6,6,0"
                            Padding="16,12"
                            Margin="0,0,0,18">
                        <TextBlock Text="🔒 Selamat &amp; Terlindung: Sistem ini membantu log masuk automatik ke laman rasmi Kementerian Pendidikan Malaysia."
                                   Style="{StaticResource HelperTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Destination Chips Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#F8F9FA"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <TextBlock Text="DELIMa 3.0"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <Border Grid.Column="2"
                                Background="#F8F9FA"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <TextBlock Text="Classroom"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdatedDateText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="tecertools Digital Solutions"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.65"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Masalah log masuk? Sila maklumkan kepada guru bertugas."
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
