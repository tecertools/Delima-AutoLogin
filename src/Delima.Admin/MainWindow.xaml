<Window x:Class="Delima.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Delima.Admin.ViewModels"
        xmlns:views="clr-namespace:Delima.Admin.Views"
        xmlns:conv="clr-namespace:Delima.Admin.Converters"
        xmlns:models="clr-namespace:Delima.Admin.Models"
        mc:Ignorable="d"
        Title="DELIMa Admin — Wizard Persediaan Sekolah" 
        Height="680" Width="1080" MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource StageBgBrush}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:StepNumberDisplayConverter x:Key="StepNumConv" />
        <conv:StepStatusToBrushConverter x:Key="StepStatusToBrushConv" />
        <conv:StepStatusToTextBrushConverter x:Key="StepStatusToTextBrushConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />

        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:FirstRunDisclaimerViewModel}">
            <views:FirstRunDisclaimerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step1IdentityViewModel}">
            <views:Step1IdentityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step2PassphraseViewModel}">
            <views:Step2PassphraseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step3RosterImportViewModel}">
            <views:Step3RosterImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step4PasswordImportViewModel}">
            <views:Step4PasswordImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step5AvatarsViewModel}">
            <views:Step5AvatarsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step6SettingsViewModel}">
            <views:Step6SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step7ProvisionViewModel}">
            <views:Step7ProvisionView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Main Application Card Frame -->
        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <Border Grid.Row="0" Padding="18,18,18,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentOrangeBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SchoolCodeDisplay}" FontWeight="ExtraBold" FontSize="10" Foreground="#1F2421" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DELIMa Admin" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding SchoolNameDisplay}" FontSize="11" Foreground="{StaticResource Ink2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step Navigator List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StepNavigationItem}">
                                        <Button Command="{Binding DataContext.NavigateToStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding StepNumber}"
                                                IsEnabled="{Binding CanNavigate}"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand" Margin="0,1">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="itemBorder" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#FFFFFF" />
                                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#ECEAE2" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Number / Status Circle Badge -->
                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                                        BorderBrush="{Binding Status, Converter={StaticResource StepStatusToBrushConv}}"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StepNumConv}, FallbackValue='1'}"
                                                               FontSize="10" FontWeight="ExtraBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StepStatusToTextBrushConv}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Step Label -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                                    <Setter Property="Foreground" Value="#B3B0A4" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT MAIN CONTENT PANE -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dynamic Step View Host -->
                    <Border Grid.Row="0" Padding="28,24,28,16" Background="#FFFFFF">
                        <ContentControl Content="{Binding CurrentStepViewModel}" />
                    </Border>

                    <!-- Bottom Action Bar with Inline Reason -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Inline Blocked Reason Text (CDS Restraint: say what's wrong, don't just refuse) -->
                            <TextBlock Grid.Column="0" Text="{Binding BlockedReason}" Foreground="{StaticResource DangerTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding BlockedReason, Converter={StaticResource NullOrEmptyToVisConv}}" TextTrimming="CharacterEllipsis" />

                            <!-- Back Button -->
                            <Button Grid.Column="1" Content="← Kembali" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}"
                                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisConv}}" />

                            <!-- Next / Proceed Button -->
                            <Button Grid.Column="3" Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding GoNextCommand}"
                                    IsEnabled="{Binding CanGoNext}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
