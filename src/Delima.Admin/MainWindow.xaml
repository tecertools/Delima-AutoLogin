<ui:FluentWindow x:Class="Delima.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Delima.Admin.ViewModels"
        xmlns:views="clr-namespace:Delima.Admin.Views"
        xmlns:conv="clr-namespace:Delima.Admin.Converters"
        xmlns:models="clr-namespace:Delima.Admin.Models"
        mc:Ignorable="d"
        Title="DELIMa Admin — Wizard Persediaan Sekolah"
        Icon="icon.ico"
        Height="700" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{StaticResource StageBgBrush}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:StepNumberDisplayConverter x:Key="StepNumConv" />
        <conv:StepStatusToBrushConverter x:Key="StepStatusToBrushConv" />
        <conv:StepStatusToTextBrushConverter x:Key="StepStatusToTextBrushConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />

        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:FirstRunDisclaimerViewModel}">
            <views:FirstRunDisclaimerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step1IdentityViewModel}">
            <views:Step1IdentityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step2PassphraseViewModel}">
            <views:Step2PassphraseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step3RosterImportViewModel}">
            <views:Step3RosterImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step4PasswordImportViewModel}">
            <views:Step4PasswordImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step5AvatarsViewModel}">
            <views:Step5AvatarsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step6SettingsViewModel}">
            <views:Step6SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Step7ProvisionViewModel}">
            <views:Step7ProvisionView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar with Caption Controls -->
        <ui:TitleBar Grid.Row="0"
                     Title="DELIMa Admin — Wizard Persediaan Sekolah"
                     Icon="icon.ico"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <!-- Main Application Card Frame (Windows 11 Fluent Layer) -->
            <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True" Effect="{StaticResource FluentCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDEBAR (WinUI 3 NavigationView Style) -->
                    <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <Border Grid.Row="0" Padding="18,16,18,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource PrimaryGreenBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SchoolCodeDisplay}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DELIMa Admin" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding SchoolNameDisplay}" FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step Navigator List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StepNavigationItem}">
                                        <Button Command="{Binding DataContext.NavigateToStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding StepNumber}"
                                                IsEnabled="{Binding CanNavigate}"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand" Margin="0,2">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="itemBorder" Padding="10,8" Background="Transparent" CornerRadius="6">
                                                                    <Grid>
                                                                        <!-- Active Indicator Pill -->
                                                                        <Border x:Name="activePill" Width="3.5" Height="18" Background="{StaticResource PrimaryGreenBrush}"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"
                                                                                Visibility="Collapsed" Margin="-6,0,0,0" />
                                                                        <ContentPresenter />
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#EAECEF" />
                                                                        <Setter TargetName="activePill" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                            <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#F1F3F5" />
                                                                    </MultiDataTrigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="itemBorder" Property="Opacity" Value="0.45" />
                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <Grid Margin="6,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Status Badge -->
                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                                        BorderBrush="{Binding Status, Converter={StaticResource StepStatusToBrushConv}}"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Converter={StaticResource StepNumConv}, FallbackValue='1'}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource StepStatusToTextBrushConv}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Step Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Normal"
                                                           VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sidebar Footer Branding & Support Link -->
                        <Border Grid.Row="2" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Button Content="☕ Sokong Pembangun"
                                        Style="{StaticResource SmallButton}"
                                        Command="{Binding OpenDonationModalCommand}"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{StaticResource PrimaryGreenBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        Cursor="Hand"
                                        Margin="0,0,0,4"
                                        ToolTip="Klik untuk melihat kod QR sumbangan" />
                                <TextBlock Text="tecertools Digital Solutions" FontSize="10.5" Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT MAIN CONTENT PANE -->
                <Grid Grid.Column="1" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dynamic Step View Host -->
                    <Border Grid.Row="0" Padding="24,20,24,16" Background="#FFFFFF">
                        <ContentControl Content="{Binding CurrentStepViewModel}" />
                    </Border>

                    <!-- Bottom Action Bar with Inline Status & Navigation -->
                    <Border Grid.Row="1" Background="#FBFBFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Inline Blocked Reason -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding BlockedReason, Converter={StaticResource NullOrEmptyToVisConv}}"
                                        Margin="0,0,10,0">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BlockedReason}" Foreground="{StaticResource DangerTextBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Back Button -->
                            <Button Grid.Column="1" Content="← Kembali" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}"
                                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisConv}}" />

                            <!-- Next / Proceed Button -->
                            <Button Grid.Column="3" Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding GoNextCommand}"
                                    IsEnabled="{Binding CanGoNext}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- DONATION MODAL (WinUI 3 ContentDialog Style) -->
    <Grid Grid.RowSpan="2" Background="#40000000" Visibility="{Binding IsDonationModalOpen, Converter={StaticResource BoolToVisConv}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Width="400" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FluentPopupShadow}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Sumbangan &amp; Sokongan" FontFamily="{StaticResource DisplayFontFamily}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Perisian ini percuma untuk semua sekolah. Jika perisian ini membantu makmal anda, anda dialu-alukan menyokong pembangunan berterusan." 
                               FontSize="12" Foreground="{StaticResource Ink2Brush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                    <!-- QR Code Frame -->
                    <Border Width="190" Height="190" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,14" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Delima.Admin;component/Assets/donation_qr.png" Stretch="Uniform" />
                    </Border>

                    <!-- Account Info Box -->
                    <Border Background="#F8F9FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Penerima:" FontSize="11.5" Foreground="{StaticResource Ink2Brush}" />
                                <TextBlock Grid.Column="1" Text="Cikgu Raja Azrien" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kaedah:" FontSize="11.5" Foreground="{StaticResource Ink2Brush}" />
                                <TextBlock Grid.Column="1" Text="DuitNow QR / Pindahan Maya" FontSize="11.5" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Tutup" Style="{StaticResource PrimaryButton}" Command="{Binding CloseDonationModalCommand}" HorizontalAlignment="Center" Width="120" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
