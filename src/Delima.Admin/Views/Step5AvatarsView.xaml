<UserControl x:Class="Delima.Admin.Views.Step5AvatarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Avatar &amp; Kata Laluan Gambar" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Avatar visual &amp; 3-simbol kata laluan gambar dijana unik bagi setiap murid mengikut tahun dan kelas." Style="{StaticResource StepSubHeading}" />

            <!-- Filter & Action Toolbar Card -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Filters and Print Action -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tapis Tahun:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                    <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding YearNames}" SelectedItem="{Binding SelectedYearFilter, Mode=TwoWay}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Tapis Kelas:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                    <ComboBox Grid.Row="0" Grid.Column="6" ItemsSource="{Binding ClassNames}" SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}" VerticalAlignment="Center" />

                    <Button Grid.Row="0" Grid.Column="8" Content="🖨️ Cetak Kata Laluan Gambar" Style="{StaticResource SecondaryButton}" Click="OnPrintAvatarSheetClick" ToolTip="Cetak helaian kata laluan gambar mengikut tahun dan kelas yang dipilih" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Avatar List Container -->
            <Border Style="{StaticResource SettingsCard}" Padding="16,10">
                <ItemsControl ItemsSource="{Binding FilteredAvatarItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- DiceBear Critter Avatar Circle -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F1F3F5" VerticalAlignment="Center" ClipToBounds="True">
                                        <Image Source="{Binding AvatarUrl}"
                                               Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding ClassName, StringFormat=' ({0})'}" Foreground="{StaticResource Ink3Brush}" FontSize="12" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding EmailLocal}" Foreground="{StaticResource Ink3Brush}" FontSize="11" FontFamily="Consolas, monospace" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Picture Password Preview Tag -->
                                    <Border Grid.Column="2" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{Binding PicturePasswordDetailedDisplay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔑 " FontSize="11" />
                                            <TextBlock Text="{Binding PicturePasswordDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E" />
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="4" Content="Tukar ↻" Style="{StaticResource SmallButton}" Click="OnCycleAvatarClick" ToolTip="Jana avatar unik baharu secara rawak" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Picture Password Policy Card -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                <StackPanel>
                    <CheckBox IsChecked="{Binding PicturePasswordRequired, Mode=TwoWay}" VerticalContentAlignment="Center" Cursor="Hand">
                        <TextBlock Text="Wajibkan Kata Laluan Gambar (3-ikon) untuk setiap murid" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                    </CheckBox>

                    <!-- WinUI 3 Warning Banner if Disabled -->
                    <Border Style="{StaticResource InfoBarDanger}" Margin="0,12,0,0"
                            Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVisConv}}">
                        <TextBlock Text="AMARAN: Melumpuhkan ciri ini mendedahkan risiko keselamatan — mana-mana murid boleh log masuk sebagai rakan sekelas dengan hanya menekan kad nama. Pilihan ini akan direkodkan dalam log audit." 
                                   TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}" FontSize="12.5" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

