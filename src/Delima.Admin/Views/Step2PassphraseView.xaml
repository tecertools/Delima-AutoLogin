<UserControl x:Class="Delima.Admin.Views.Step2PassphraseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Kata Laluan Pentadbir" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Kunci induk bagi semua bungkusan sekolah ini. Tiada pemulihan jika hilang." Style="{StaticResource StepSubHeading}" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kata Laluan Pentadbir (min. 12 aksara)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sahkan Kata Laluan" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ConfirmPassphrase, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Kekuatan Kata Laluan" Style="{StaticResource FieldLabel}" />
                <Border Height="7" Background="#EEECE4" CornerRadius="4" Margin="0,4,0,6">
                    <Grid HorizontalAlignment="Left">
                        <Border Height="7" CornerRadius="4" Width="{Binding StrengthResult.ScorePercent, StringFormat='{}{0}0'}" Background="{Binding StrengthResult.BarColorHex, Converter={StaticResource HexToBrushConv}}" MinWidth="8" MaxWidth="600" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding StrengthResult.HintText}" FontSize="11.5" Foreground="{StaticResource Ink2Brush}" />
            </StackPanel>

            <Border Background="{StaticResource AmberBgBrush}" BorderBrush="#EAD7B0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <CheckBox IsChecked="{Binding HasAgreedNoRecovery, Mode=TwoWay}" VerticalContentAlignment="Center">
                    <TextBlock Text="Saya faham bahawa jika kata laluan ini hilang, tiada cara untuk memulihkannya — saya perlu mengimport semula daripada eksport APDM." 
                               TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource AmberTextBrush}" FontSize="12.5" Margin="6,0,0,0" />
                </CheckBox>
            </Border>

            <!-- Recovery Sheet Preview -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource StripeBgBrush}" Padding="14"
                    Visibility="{Binding RecoverySheet, Converter={StaticResource NullOrEmptyToVisConv}}">
                <StackPanel>
                    <TextBlock Text="Helaian Pemulihan (Pratonton KCV)" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Helaian ini mengandungi Key-Check Value (KCV) dan arahan persediaan semula. Kunci induk tidak ditulis pada helaian ini." FontSize="12" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kod Sekolah:" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.SchoolCode}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="KCV (Fingerprint):" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.KeyCheckValue}" Style="{StaticResource MonoText}" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tarikh Dicipta:" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.CreationDate, StringFormat='{}{0:yyyy-MM-dd HH:mm UTC}'}" Style="{StaticResource MonoText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
