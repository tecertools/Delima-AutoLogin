<UserControl x:Class="Delima.Admin.Views.Step2PassphraseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Kata Laluan Pentadbir" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Kunci induk bagi penyulitan semua pakej sekolah ini. Tiada pelayan pemulihan jika hilang." Style="{StaticResource StepSubHeading}" />

            <!-- Passphrase Entry Card (SettingsCard) -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kata Laluan Pentadbir (min. 12 aksara)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sahkan Kata Laluan" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ConfirmPassphrase, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Strength Meter -->
                    <TextBlock Text="Kekuatan Kata Laluan" Style="{StaticResource FieldLabel}" />
                    <Border Height="6" Background="#EAEAEA" CornerRadius="3" Margin="0,4,0,6">
                        <Grid HorizontalAlignment="Left">
                            <Border Height="6" CornerRadius="3" Width="{Binding StrengthResult.ScorePercent, StringFormat='{}{0}0'}" Background="{Binding StrengthResult.BarColorHex, Converter={StaticResource HexToBrushConv}}" MinWidth="8" MaxWidth="600" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding StrengthResult.HintText}" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                </StackPanel>
            </Border>

            <!-- WinUI 3 Warning InfoBar -->
            <Border Style="{StaticResource InfoBarWarning}" Margin="0,4,0,12">
                <CheckBox IsChecked="{Binding HasAgreedNoRecovery, Mode=TwoWay}" VerticalContentAlignment="Center" Cursor="Hand">
                    <TextBlock Text="Saya faham bahawa jika kata laluan ini hilang, tiada cara untuk memulihkannya — saya perlu mengimport semula fail senarai murid." 
                               TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource AmberTextBrush}" FontSize="12.5" Margin="8,0,0,0" />
                </CheckBox>
            </Border>

            <!-- Recovery Sheet Preview (SettingsCard) -->
            <Border Style="{StaticResource SettingsCard}"
                    Visibility="{Binding RecoverySheet, Converter={StaticResource NullOrEmptyToVisConv}}">
                <StackPanel>
                    <TextBlock Text="Helaian Pemulihan (Pratonton KCV)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="Helaian ini mengandungi Key-Check Value (KCV) dan arahan persediaan semula. Kunci induk sebenar tidak akan ditulis pada helaian ini." FontSize="12" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kod Sekolah:" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.SchoolCode}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="KCV (Fingerprint):" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.KeyCheckValue}" Style="{StaticResource MonoText}" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tarikh Dicipta:" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecoverySheet.CreationDate, StringFormat='{}{0:yyyy-MM-dd HH:mm UTC}'}" Style="{StaticResource MonoText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
