<UserControl x:Class="Delima.Admin.Views.Step3RosterImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="760">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisConv" Invert="True" />
        <conv:StringEqualityConverter x:Key="StringEqConv" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Import Senarai Murid (Roster)" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Import maklumat nama, kelas dan ID akaun DELIMa murid daripada fail CSV atau lembaran kerja Excel (APDM/SPS)." Style="{StaticResource StepSubHeading}" />

            <!-- Sub-Step Segmented Navigation (WinUI 3 Segmented Control) -->
            <Border Background="#F1F3F5" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="1. Pemetaan Lajur" Style="{StaticResource SubStepToggleButton}" Margin="0,0,2,0"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=Mapping, Mode=TwoWay}" />
                    <RadioButton Content="2. Laporan Percubaan (Dry-Run)" Style="{StaticResource SubStepToggleButton}"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=DryRun, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- SUB-VIEW 3A: COLUMN MAPPING -->
            <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=Mapping}">
                
                <!-- 1. EMPTY STATE: PROMINENT DASHED DROPZONE -->
                <Border Style="{StaticResource SettingsCard}" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop"
                        Background="#FAFBFC" Padding="24,20" Margin="0,0,0,10"
                        Visibility="{Binding HasFileLoaded, Converter={StaticResource InverseBoolToVisConv}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.8" />
                        <TextBlock Text="Seret &amp; Lepas Fail Senarai Murid ke Sini" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Menyokong fail CSV (.csv), Excel (.xlsx, .xls) atau teks (.tsv, .txt) yang dieksport dari APDM / SPS." 
                                   Foreground="{StaticResource Ink2Brush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📁 Pilih Fail Dari Komputer…" Style="{StaticResource PrimaryButton}" Click="OnSelectFileClick" Margin="0,0,10,0" />
                            <Button Content="📥 Muat Turun Templat (CSV)" Style="{StaticResource SecondaryButton}" Click="OnDownloadTemplateClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. LOADED FILE SUMMARY CARD -->
                <Border Style="{StaticResource SettingsCard}" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop" Margin="0,0,0,10"
                        Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- File Icon & Details -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalRawRowCount, StringFormat='{}{0} rekod dijumpai'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="#F1F3F5" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding DetectedEncoding, StringFormat='Pengekodan: {0}'}" FontSize="10.5" Foreground="{StaticResource Ink2Brush}" FontFamily="Consolas, monospace" />
                                </Border>
                                <TextBlock Text="{Binding DiacriticPreview, StringFormat='Contoh: {0}'}" FontSize="11" Foreground="{StaticResource Ink3Brush}" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Tukar Fail…" Style="{StaticResource SecondaryButton}" Click="OnSelectFileClick" Margin="0,0,6,0" />
                            <Button Content="✕ Batal" Style="{StaticResource DangerButton}" Click="OnClearFileClick" ToolTip="Padam fail ini" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. TARGET FIELDS MAPPING CARD -->
                <Border Style="{StaticResource SettingsCard}"
                        Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Padankan 5 Lajur Sasaran" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Lajur telah dipadankan secara automatik mengikut kepala jadual fail anda." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="✓ Dipadankan Automatik" FontSize="10" FontWeight="Bold" Foreground="#047857" />
                            </Border>
                        </Grid>

                        <!-- Row 1: Nama Penuh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Nama penuh murid" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedFullNameCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 2: Kelas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kelas" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedClassNameCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 3: Tahun -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tahun / Tingkatan" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding SelectedGradeCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 4: ID DELIMa -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ID DELIMa (cth: m-12345678)" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedDelimaIdCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 5: No. KP / Daftar -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="No. KP / No. Daftar (Kunci Gabung)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedRegisterNoCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Direct Dry-Run Trigger Button -->
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <Button Content="▶ Jalankan Analisis Percubaan (Dry-Run) ➔" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right" Click="OnRunDryRunClick"
                                    IsEnabled="{Binding CanProceedToDryRun}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. LIVE PREVIEW DATAGRID -->
                <StackPanel Margin="0,4,0,10" Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <TextBlock Text="Pratonton Langsung Data Roster (10 Baris Pertama)" Style="{StaticResource FieldLabel}" />
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding PreviewRows}" MaxHeight="220" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45" ElementStyle="{StaticResource MonoText}" />
                                <DataGridTextColumn Header="NAMA PENUH" Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="KELAS" Binding="{Binding ClassName}" Width="1*" />
                                <DataGridTextColumn Header="TAHUN" Binding="{Binding Grade}" Width="65" ElementStyle="{StaticResource MonoText}" />
                                <DataGridTextColumn Header="ID DELIMA" Binding="{Binding EmailLocal}" Width="130" ElementStyle="{StaticResource MonoText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- SUB-VIEW 3B: DRY RUN REPORT -->
            <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=DryRun}">
                
                <!-- Navigation Bar back to Mapping -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="← Kembali ke Pemetaan Lajur" Style="{StaticResource SecondaryButton}" Click="OnBackToMappingClick" />
                </Grid>

                <!-- 3 METRIC TILES ROW -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile 1: Ready to Import (Green) -->
                    <Border Grid.Column="0" Style="{StaticResource SettingsCard}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🟢 Sedia Diimport" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" />
                            <TextBlock Text="{Binding DryRunReport.ValidCount, FallbackValue='0'}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource SuccessTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Murid sah melepasi semakan" FontSize="11" Foreground="{StaticResource Ink2Brush}" />
                        </StackPanel>
                    </Border>

                    <!-- Tile 2: Warnings (Amber) -->
                    <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🟡 Amaran (Dibaiki)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AmberTextBrush}" />
                            <TextBlock Text="{Binding DryRunReport.Warnings.Count, FallbackValue='0'}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AmberTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Nama / kelas diubah suai" FontSize="11" Foreground="{StaticResource Ink2Brush}" />
                        </StackPanel>
                    </Border>

                    <!-- Tile 3: Rejects (Red) -->
                    <Border Grid.Column="4" Style="{StaticResource SettingsCard}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🔴 Ditolak (Ralat)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource DangerTextBrush}" />
                            <TextBlock Text="{Binding DryRunReport.Rejects.Count, FallbackValue='0'}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource DangerTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Data tidak sah / tiada nama" FontSize="11" Foreground="{StaticResource Ink2Brush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rejects Card (if any) -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rekod Ditolak (Ralat Format)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="📥 Eksport CSV Ditolak" Style="{StaticResource SmallButton}" Click="OnExportRejectsClick" />
                        </Grid>
                        
                        <TextBlock Text="Tiada rekod ditolak. Semua data murid sah!" Foreground="{StaticResource SuccessTextBrush}" FontWeight="SemiBold" FontSize="12"
                                   Visibility="{Binding DryRunReport.Rejects.Count, Converter={StaticResource NullOrEmptyToVisConv}, FallbackValue=Collapsed}" Margin="0,4,0,4" />

                        <ItemsControl ItemsSource="{Binding DryRunReport.Rejects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RowNumber, StringFormat='Baris {0}'}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding StudentName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource DangerTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Warnings Card (if any) -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Amaran Integriti Data (Pembetulan Automatik)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding DryRunReport.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RowNumber, StringFormat='Baris {0}'}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Resolution, StringFormat='→ {0}'}" Foreground="{StaticResource Ink2Brush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Summary Statistics Log -->
                <Border Background="#F8F9FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="{Binding DryRunSummaryText}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

