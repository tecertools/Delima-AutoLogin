<UserControl x:Class="Delima.Admin.Views.Step3RosterImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:StringEqualityConverter x:Key="StringEqConv" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Import Senarai Murid" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Import maklumat nama, kelas dan ID DELIMa murid daripada fail senarai murid (CSV/Excel)." Style="{StaticResource StepSubHeading}" />

            <!-- Sub-Step Segmented Navigation (WinUI 3 Segmented Control) -->
            <Border Background="#F1F3F5" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="1. Pemetaan Lajur" Style="{StaticResource SubStepToggleButton}" Margin="0,0,2,0"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=Mapping, Mode=TwoWay}" />
                    <RadioButton Content="2. Laporan Percubaan" Style="{StaticResource SubStepToggleButton}"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=DryRun, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- SUB-VIEW 3A: COLUMN MAPPING -->
            <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=Mapping}">
                <!-- File Picker & Drop Zone Card -->
                <Border Style="{StaticResource SettingsCard}" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fail Roster Murid (.csv, .xlsx, .xls, .tsv)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="📥 Muat Turun Templat (CSV)" Style="{StaticResource SmallButton}" Click="OnDownloadTemplateClick" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Pilih Fail…" Style="{StaticResource SecondaryButton}" Click="OnSelectFileClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Encoding Sniffer Status -->
                <Border Style="{StaticResource InfoBarSuccess}" Margin="0,0,0,12"
                        Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pengekodan &amp; Nama Khas: " FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" FontSize="12.5"/>
                        <TextBlock Grid.Column="1" Text="{Binding DiacriticPreview}" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Normal" FontSize="12.5" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- 5 Target Fields Mapping (SettingsCard) -->
                <Border Style="{StaticResource SettingsCard}"
                        Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <StackPanel>
                        <TextBlock Text="Padankan 5 Lajur Sasaran" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                        <!-- Row 1: Nama Penuh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Nama penuh murid" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedFullNameCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 2: Kelas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kelas" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedClassNameCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 3: Tahun -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tahun / Tingkatan" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding SelectedGradeCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 4: ID DELIMa -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ID DELIMa (cth: m-12345678)" FontWeight="SemiBold" />
                                <TextBlock Text=" *" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedDelimaIdCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>

                        <!-- Row 5: No. KP / Daftar -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="No. KP / No. Daftar (Kunci Gabung)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceHeaders}" SelectedItem="{Binding SelectedRegisterNoCol, Mode=TwoWay}" SelectionChanged="OnMappingSelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Preview DataGrid -->
                <StackPanel Margin="0,4,0,10" Visibility="{Binding HasFileLoaded, Converter={StaticResource BoolToVisConv}}">
                    <TextBlock Text="Pratonton Langsung (10 Baris Pertama)" Style="{StaticResource FieldLabel}" />
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding PreviewRows}" MaxHeight="220" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45" ElementStyle="{StaticResource MonoText}" />
                                <DataGridTextColumn Header="NAMA PENUH" Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="KELAS" Binding="{Binding ClassName}" Width="1*" />
                                <DataGridTextColumn Header="TAHUN" Binding="{Binding Grade}" Width="65" ElementStyle="{StaticResource MonoText}" />
                                <DataGridTextColumn Header="ID DELIMA" Binding="{Binding EmailLocal}" Width="130" ElementStyle="{StaticResource MonoText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- SUB-VIEW 3B: DRY RUN REPORT -->
            <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=DryRun}">
                <!-- Ready to Import Card -->
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Sedia Diimport (Murid Sah)" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Rekod murid yang lengkap dan melepasi semakan integriti." Foreground="{StaticResource Ink2Brush}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource SuccessBgBrush}" CornerRadius="12" Padding="12,4">
                            <TextBlock Text="{Binding DryRunReport.ValidCount, FallbackValue='0'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessTextBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Warnings Card -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amaran (Tidak Menghalang)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{StaticResource AmberBgBrush}" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="{Binding DryRunReport.Warnings.Count, FallbackValue='0'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AmberTextBrush}" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DryRunReport.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RowNumber, StringFormat='Baris {0}'}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Resolution, StringFormat='→ {0}'}" Foreground="{StaticResource Ink2Brush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Rejects Card -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ditolak (Ralat Format / Tidak Sah)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{StaticResource DangerBgBrush}" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="{Binding DryRunReport.Rejects.Count, FallbackValue='0'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource DangerTextBrush}" />
                            </Border>
                            <Button Grid.Column="3" Content="Eksport CSV Ditolak" Style="{StaticResource SmallButton}" Click="OnExportRejectsClick" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DryRunReport.Rejects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RowNumber, StringFormat='Baris {0}'}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StudentName}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" Foreground="{StaticResource DangerTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Summary Statistics -->
                <Border Background="#F8F9FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="{Binding DryRunSummaryText}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink2Brush}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
