<UserControl x:Class="Delima.Admin.Views.Step4PasswordImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisConv" Invert="True" />
        <conv:StringEqualityConverter x:Key="StringEqConv" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Import Kata Laluan" Style="{StaticResource StepHeading}" />
                <TextBlock Text="Langkah berasingan, dengan pengesahan berasingan — dengan sengaja." Style="{StaticResource StepSubHeading}" />

                <!-- Sub-Step Toggle Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton Content="1. Persetujuan Maklumat" Style="{StaticResource SubStepToggleButton}" Margin="0,0,8,0"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=Consent, Mode=TwoWay}" />
                    <RadioButton Content="2. Grid &amp; Pengurusan Kata Laluan" Style="{StaticResource SubStepToggleButton}"
                                 IsChecked="{Binding ActiveSubView, Converter={StaticResource StringEqConv}, ConverterParameter=Grid, Mode=TwoWay}" />
                </StackPanel>

                <!-- SUB-VIEW 4A: INFORMED CONSENT -->
                <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=Consent}">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Sebelum Meneruskan Pengendalian Kata Laluan" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                            <!-- Statement 1 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AmberBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="1" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AmberTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Kata laluan murid akan disimpan dalam bentuk disulitkan dengan AES-256-GCM." VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                            </Grid>

                            <!-- Statement 2 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AmberBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="2" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AmberTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Ia disimpan pada PC ini sahaja — tiada salinan awan, tiada pelayan pusat." VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                            </Grid>

                            <!-- Statement 3 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AmberBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="3" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AmberTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Sesiapa dengan akses pentadbir tempatan pada PC ini boleh memulihkan data tersebut." VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                            </Grid>

                            <!-- Statement 4 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AmberBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="4" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AmberTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Sekolah — bukan pembekal perisian — bertanggungjawab ke atas keputusan ini." VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Taip kod sekolah untuk teruskan (geseran keselamatan sengaja):" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ConsentTypedCode, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="{Binding ConsentValidationMessage}" Foreground="{StaticResource AmberTextBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding ConsentIsMatched, Converter={StaticResource InverseBoolToVisConv}}" />
                    </StackPanel>
                </StackPanel>

                <!-- SUB-VIEW 4B: PASSWORD GRID & REVEAL -->
                <StackPanel Visibility="{Binding ActiveSubView, Converter={StaticResource EqToVisConv}, ConverterParameter=Grid}">
                    <!-- Controls Bar -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Muat Naik Fail Kata Laluan…" Style="{StaticResource SmallPrimaryButton}" Click="OnLoadPasswordFileClick" />
                        <Button Grid.Column="2" Content="📥 Muat Turun Templat" Style="{StaticResource SmallButton}" Click="OnDownloadPasswordTemplateClick" />
                        <Button Grid.Column="4" Content="Tutup Semua Pendedahan" Style="{StaticResource SmallButton}" Click="OnMaskAllClick" />

                        <!-- Summary Counters -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="{StaticResource StripeBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                <TextBlock Text="{Binding WithPasswordCount, StringFormat='{}Ada: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                            </Border>
                            <Border Background="{StaticResource StripeBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MissingPasswordCount, StringFormat='{}Tiada: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink2Brush}" />
                            </Border>
                            <Border Background="{StaticResource AmberBgBrush}" BorderBrush="#EAD7B0" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="{Binding SharedPasswordCount, StringFormat='{}Dikongsi: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding PasswordItems}" MaxHeight="320" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAMA" Binding="{Binding StudentName}" Width="2*" />
                            <DataGridTextColumn Header="KELAS" Binding="{Binding ClassName}" Width="1*" />
                            <DataGridTextColumn Header="ID DELIMA" Binding="{Binding EmailLocal}" Width="110" ElementStyle="{StaticResource MonoText}" />
                            
                            <!-- Password Column with Per-Row Click to Reveal -->
                            <DataGridTemplateColumn Header="KATA LALUAN" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding MaskedText}" Style="{StaticResource SmallButton}" BorderThickness="0" Background="Transparent" 
                                                    FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Cursor="Hand" Click="OnPasswordCellClick" />
                                            <TextBlock Text="{Binding RevealCountdownSeconds, StringFormat='{} ({0}s)'}" FontSize="10" Foreground="{StaticResource DangerTextBrush}" FontWeight="Bold" VerticalAlignment="Center"
                                                       Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVisConv}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge Column -->
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                Visibility="{Binding StatusBadge, Converter={StaticResource NullOrEmptyToVisConv}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EFEDE4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AmberBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="* Klik pada '••••••••' untuk mendedahkan kata laluan murid dengan memasukkan kata laluan pentadbir. Auto-topeng semula selepas 10 saat." FontSize="11" Foreground="{StaticResource Ink2Brush}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Passphrase Reveal Modal / Popover Layer -->
        <Grid Background="#40000000" Visibility="{Binding IsPopoverOpen, Converter={StaticResource BoolToVisConv}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Width="300" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sahkan Kata Laluan Pentadbir" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ActivePopoverItem.StudentName, StringFormat='Dedah kata laluan untuk: {0}'}" FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,10" />
                    
                    <PasswordBox x:Name="PopoverPasswordBox" Height="32" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PopoverError}" Foreground="{StaticResource DangerTextBrush}" FontSize="11.5" Margin="0,0,0,8"
                               Visibility="{Binding PopoverError, Converter={StaticResource NullOrEmptyToVisConv}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Style="{StaticResource SmallButton}" Click="OnCancelPopoverClick" />
                        <Button Grid.Column="2" Content="Dedah" Style="{StaticResource SmallPrimaryButton}" Click="OnConfirmRevealClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
