<UserControl x:Class="Delima.Admin.Views.Step7ProvisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:StringEqualityConverter x:Key="StringEqConv" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Bina &amp; Sediakan" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Membina school.dlmpack (AES-256-GCM) dan menyediakan PC makmal." Style="{StaticResource StepSubHeading}" />

            <!-- 3 Provisioning Route Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- USB Card -->
                <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Usb">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Pendrive" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,4" />
                        <TextBlock Text="Pendrive kosong, 1 GB+. Jalankan Provision.exe pada setiap PC." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,10" />
                        <Button Content="Pilih Pendrive" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectUsbRouteClick" />
                    </StackPanel>
                </Border>

                <!-- Network Share Card -->
                <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Network">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Rangkaian" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,4" />
                        <TextBlock Text="Laluan UNC boleh dicapai daripada setiap PC makmal." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,10" />
                        <Button Content="Pilih Rangkaian" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectNetworkRouteClick" />
                    </StackPanel>
                </Border>

                <!-- Scripted Card -->
                <Border Grid.Column="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Script">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Skrip" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,4" />
                        <TextBlock Text="Skrip PowerShell untuk PDQ/GPO merentasi makmal." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,10" />
                        <Button Content="Pilih Skrip" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectScriptRouteClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Route Sub-Panels -->
            <!-- Sub-Panel USB -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource StripeBgBrush}" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Usb}">
                <StackPanel>
                    <TextBlock Text="Penyediaan Melalui Pendrive USB" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Pilih lokasi fail untuk menyimpan bungkusan 'school.dlmpack'." FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,10" />
                    <Button Content="Bina &amp; Simpan school.dlmpack…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnSaveBundleFileClick" />
                </StackPanel>
            </Border>

            <!-- Sub-Panel Network -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource StripeBgBrush}" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Network}">
                <StackPanel>
                    <TextBlock Text="Penyediaan Melalui Perkongsian Rangkaian (UNC)" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Masukkan laluan folder rangkaian yang boleh dicapai oleh PC makmal:" FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NetworkSharePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Salin ke Rangkaian" Style="{StaticResource PrimaryButton}" Click="OnSaveToNetworkClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sub-Panel Script -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource StripeBgBrush}" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Script}">
                <StackPanel>
                    <TextBlock Text="Skrip Automasi PowerShell (PDQ / GPO / RMM)" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Kata laluan pentadbir ditanya secara interaktif dalam memori dan tidak disimpan di dalam fail skrip." FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding PowerShellScript}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Style="{StaticResource MonoText}" Margin="0,0,0,10" />
                    <Button Content="Salin Skrip ke Papan Keratan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnCopyScriptClick" />
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="#E5F2EA" BorderBrush="#B2D8C0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisConv}}">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
            </Border>

            <!-- Lab Checklist Preview -->
            <StackPanel Margin="0,0,0,10">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Senarai Semak Makmal (Pratonton Status PC)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                    <Button Grid.Column="1" Content="Eksport Senarai Semak (.csv)" Style="{StaticResource SmallButton}" Click="OnExportChecklistClick" />
                </Grid>

                <DataGrid ItemsSource="{Binding LabChecklist}" MaxHeight="220" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAMA PC" Binding="{Binding PcName}" Width="150" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="DISEDIAKAN" Binding="{Binding IsProvisioned, StringFormat='{}{0}'}" Width="120" />
                        <DataGridTextColumn Header="VERSI" Binding="{Binding Version}" Width="90" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="TARIKH SIMPAN" Binding="{Binding StoreDate}" Width="*" ElementStyle="{StaticResource MonoText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
