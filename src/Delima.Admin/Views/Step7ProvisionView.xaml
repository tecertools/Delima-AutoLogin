<UserControl x:Class="Delima.Admin.Views.Step7ProvisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Delima.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="750">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisConv" Invert="True" />
        <conv:StringEqualityConverter x:Key="StringEqConv" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Bina &amp; Sediakan" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Membina bungkusan 'school.dlmpack' disulitkan (AES-256-GCM) dan menyediakan PC makmal." Style="{StaticResource StepSubHeading}" />

            <!-- 3 Provisioning Route Cards -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- USB Card -->
                <Border Grid.Column="0" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Usb">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="Background" Value="#F4FAF6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Pendrive USB (Disyorkan)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="Simpan pakej lengkap ke pendrive. Klik '1_Sediakan_Makmal.exe' pada setiap PC." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,12" />
                        <Button Content="Pilih Pendrive" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectUsbRouteClick"
                                IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </Border>

                <!-- Network Share Card -->
                <Border Grid.Column="2" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Network">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="Background" Value="#F4FAF6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Rangkaian Tempatan" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="Laluan UNC perkongsian rangkaian yang boleh dicapai oleh PC makmal." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,12" />
                        <Button Content="Pilih Rangkaian" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectNetworkRouteClick"
                                IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </Border>

                <!-- Scripted Card -->
                <Border Grid.Column="4" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="Script">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                    <Setter Property="Background" Value="#F4FAF6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Skrip Automasi" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="Skrip PowerShell untuk edaran PDQ, GPO atau RMM seluruh makmal." FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,12" />
                        <Button Content="Pilih Skrip" Style="{StaticResource SmallPrimaryButton}" Click="OnSelectScriptRouteClick"
                                IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Route Details Sub-Panels -->
            <!-- Sub-Panel USB -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Usb}">
                <StackPanel>
                    <TextBlock Text="Penyediaan Turnkey Melalui Pendrive USB" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4" />
                    <TextBlock Text="Menjana bungkusan sekolah disulitkan serta menyalin aplikasi persediaan '1_Sediakan_Makmal.exe' dan ikon avatar terus ke pendrive anda." FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,12" />

                    <!-- USB Drive Selection Toolbar -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Detected USB State -->
                            <StackPanel Visibility="{Binding HasAnyUsbDrive, Converter={StaticResource BoolToVisConv}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pilih Pendrive USB:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DetectedUsbDrives}" SelectedItem="{Binding SelectedUsbDrive, Mode=TwoWay}" DisplayMemberPath="DisplayName" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsNotBusy}" />
                                    <Button Grid.Column="4" Content="↻ Imbas Semula" Style="{StaticResource SmallButton}" Click="OnRefreshUsbClick" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsNotBusy}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🚀 Simpan Pakej Lengkap ke Pendrive Ini" Style="{StaticResource PrimaryButton}" Click="OnSaveToSelectedUsbClick" Margin="0,0,10,0"
                                            IsEnabled="{Binding IsNotBusy}" />
                                    <Button Content="📁 Pilih Folder Manual…" Style="{StaticResource SecondaryButton}" Click="OnSaveBundleFileClick"
                                            IsEnabled="{Binding IsNotBusy}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- No USB Detected State -->
                            <StackPanel Visibility="{Binding HasAnyUsbDrive, Converter={StaticResource InverseBoolToVisConv}}">
                                <TextBlock Text="Tiada pendrive USB dikesan secara automatik. Sila palamkan pendrive atau pilih folder secara manual." Foreground="{StaticResource Ink2Brush}" FontSize="12" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="↻ Imbas Semula USB" Style="{StaticResource SmallPrimaryButton}" Click="OnRefreshUsbClick" Margin="0,0,10,0"
                                            IsEnabled="{Binding IsNotBusy}" />
                                    <Button Content="📁 Pilih Folder / Pemacu Manual…" Style="{StaticResource SecondaryButton}" Click="OnSaveBundleFileClick"
                                            IsEnabled="{Binding IsNotBusy}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3-Step Visual Deployment Guide -->
                    <TextBlock Text="Langkah Penyediaan di Setiap PC Makmal:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="1. 🔌 Palamkan Pendrive" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Cucuk pendrive pada PC makmal sasaran." FontSize="11" Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Step 2 -->
                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="2. 🖱️ Klik 1_Sediakan_Makmal" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Buka pendrive dan dwi-klik fail persediaan." FontSize="11" Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Step 3 -->
                        <Border Grid.Column="4" Background="#F1F5F9" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="3. 🔑 Masukkan Kata Laluan" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Isi kata laluan pentadbir &amp; klik 'Sediakan'." FontSize="11" Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sub-Panel Network -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Network}">
                <StackPanel>
                    <TextBlock Text="Penyediaan Melalui Perkongsian Rangkaian (UNC)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="Masukkan laluan folder rangkaian yang boleh dicapai oleh PC makmal:" FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NetworkSharePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="2" Content="Salin ke Rangkaian" Style="{StaticResource PrimaryButton}" Click="OnSaveToNetworkClick"
                                IsEnabled="{Binding IsNotBusy}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sub-Panel Script -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14"
                    Visibility="{Binding SelectedRoute, Converter={StaticResource EqToVisConv}, ConverterParameter=Script}">
                <StackPanel>
                    <TextBlock Text="Skrip Automasi PowerShell (PDQ / GPO / RMM)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="Kata laluan pentadbir ditanya secara interaktif dalam memori dan tidak disimpan di dalam fail skrip." FontSize="12" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding PowerShellScript}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Style="{StaticResource MonoTextBox}" Margin="0,0,0,10" />
                    <Button Content="📋 Salin Skrip ke Papan Keratan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnCopyScriptClick"
                            IsEnabled="{Binding IsNotBusy}" />
                </StackPanel>
            </Border>

            <!-- Busy InfoBar (animated spinner) -->
            <Border Style="{StaticResource InfoBarBusy}" Margin="0,0,0,14"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConv}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Spinning arc -->
                    <Ellipse x:Name="BusySpinner" Width="16" Height="16" Margin="0,0,10,0"
                             Stroke="{StaticResource InfoTextBrush}" StrokeThickness="2.5"
                             StrokeDashArray="3 2"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource InfoTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Error InfoBar -->
            <Border Style="{StaticResource InfoBarDanger}" Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisConv}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="{StaticResource DangerTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- WinUI 3 Status InfoBar with Folder Opener -->
            <Border Style="{StaticResource InfoBarSuccess}" Margin="0,0,0,14"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisConv}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="📂 Buka Folder" Style="{StaticResource SmallButton}" Click="OnOpenExportedFolderClick" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Lab Checklist DataGrid -->
            <StackPanel Margin="0,0,0,10">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Senarai Semak Makmal (Pratonton Status PC)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                    <Button Grid.Column="1" Content="Eksport Senarai Semak (.csv)" Style="{StaticResource SmallButton}" Click="OnExportChecklistClick" />
                </Grid>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding LabChecklist}" MaxHeight="220" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAMA PC" Binding="{Binding PcName}" Width="160" ElementStyle="{StaticResource MonoText}" />
                            <DataGridTextColumn Header="DISEDIAKAN" Binding="{Binding IsProvisioned, StringFormat='{}{0}'}" Width="130" />
                            <DataGridTextColumn Header="VERSI" Binding="{Binding Version}" Width="95" ElementStyle="{StaticResource MonoText}" />
                            <DataGridTextColumn Header="TARIKH SIMPAN" Binding="{Binding StoreDate}" Width="*" ElementStyle="{StaticResource MonoText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- Optional Support Card -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="☕ Sokong Pembangunan DELIMa Smart Launcher" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Perisian ini percuma untuk semua sekolah. Anda boleh menyumbang secara sukarela kepada pembangun." Foreground="{StaticResource Ink2Brush}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Kod QR Sumbangan" Style="{StaticResource SmallButton}"
                            Command="{Binding DataContext.OpenDonationModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
