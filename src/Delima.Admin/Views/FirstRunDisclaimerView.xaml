<UserControl x:Class="Delima.Admin.Views.FirstRunDisclaimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Delima.Admin.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700">
    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Makluman Penting &amp; Tanggungjawab Dasar (T0.1)" Style="{StaticResource StepHeading}" />
            <TextBlock Text="Sila baca makluman dasar ini sebelum memulakan wizard persediaan kali pertama." Style="{StaticResource StepSubHeading}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource StripeBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource AmberBgBrush}" BorderBrush="#EAD7B0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Pernyataan Tanggungjawab Penggunaan Perisian" FontWeight="Bold" Foreground="{StaticResource AmberTextBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Perisian ini dibangunkan untuk membantu operasi makmal komputer sekolah, namun pengendalian data murid tertakluk kepada ketetapan pentadbiran sekolah." TextWrapping="Wrap" Foreground="{StaticResource AmberTextBrush}" FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="1. Penyimpanan Kata Laluan Tempatan" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Perisian ini menyimpan kata laluan murid dalam bentuk disulitkan (AES-256-GCM / DPAPI) pada storan komputer sekolah ini sahaja. Tiada pelayan awan atau pangkalan data berpusat yang digunakan." TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,14" />

                    <TextBlock Text="2. Tiada Pendirian Rasmi Bertulis KPM/BSTP" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Pembangun perisian ini tidak memegang sebarang surat kelulusan atau pendirian dasar bertulis daripada pihak BSTP atau Kementerian Pendidikan Malaysia (KPM) mengenai amalan menyimpan semula kata laluan murid." TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,14" />

                    <TextBlock Text="3. Sekolah Sebagai Pengawal Data (Data Controller)" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Pihak sekolah yang memasang dan menggunakan perisian ini adalah pengawal data mutlak di bawah Akta Perlindungan Data Peribadi 2010 (PDPA) dan bertanggungjawab sepenuhnya terhadap kebenaran dan penggunaan akaun DELIMa murid." TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,14" />

                    <TextBlock Text="4. Tiada Waranti &amp; Tiada Penghantaran Data" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Perisian ini disediakan secara sumber terbuka dan percuma tanpa sebarang waranti. Tiada sebarang data murid, log masuk, atau maklumat sekolah dihantar kepada pembangun." TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,14" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AmberBgBrush}" BorderBrush="#EAD7B0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
            <CheckBox IsChecked="{Binding HasReadNotice, Mode=TwoWay}" VerticalContentAlignment="Center">
                <TextBlock Text="Saya telah membaca dan memahami pernyataan tanggungjawab di atas bagi pihak sekolah." FontWeight="SemiBold" Foreground="{StaticResource AmberTextBrush}" FontSize="12.5" Margin="6,0,0,0" />
            </CheckBox>
        </Border>
    </Grid>
</UserControl>
