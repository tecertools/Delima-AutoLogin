# ===========================================================================
# DELIMa Smart Launcher — .gitattributes
# Enforces consistent line endings across all developer machines.
# ===========================================================================

# Default: normalise all text files to LF in the repo, check out as native.
* text=auto eol=lf

# Force CRLF for Windows-only files that tools expect CRLF
*.sln        text eol=crlf
*.iss        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.psm1       text eol=crlf

# Source code — always LF
*.cs         text eol=lf
*.xaml       text eol=lf
*.csproj     text eol=lf
*.props      text eol=lf
*.targets    text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf

# Binary files — no line-ending conversion
*.png        binary
*.ico        binary
*.pdf        binary
*.exe        binary
*.dll        binary
*.pdb        binary
