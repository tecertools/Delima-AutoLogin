# ---------------------------------------------------------------------------
# Credentials and pupil data — NOTHING in these categories may ever be committed
# ---------------------------------------------------------------------------
*.dlmpack
*.dat
*.entropy
credentials*
roster.json
*.csv
*.xlsx
*.xls
!contoh_*.csv
!**/fixtures/**/*.csv
/audit/
*.log

# Spike output — ignored by default (a run against real, if synthetic, test
# data shouldn't accumulate in the working tree), but results worth keeping as
# evidence are committed deliberately into spike-results/. These are synthetic
# passwords hardcoded in InjectionSpike/Program.cs, never real credentials.
fidelity_*.csv
timing_*.csv
!spike-results/*.csv

