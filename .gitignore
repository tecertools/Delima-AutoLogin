# ===========================================================================
# DELIMa Smart Launcher - .gitignore
# Clean repository configuration: only source code and documentation.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Credentials, Security & Sensitive Pupil Data (CRITICAL - NEVER COMMIT)
# ---------------------------------------------------------------------------
*.dlmpack
*.dat
*.entropy
credentials*
roster.json
/audit/
*.log

# CSV / Excel data files (ignore by default; allow explicit template & fixture files)
*.csv
*.tsv
*.xlsx
*.xls
/fidelity_*.csv
/timing_*.csv
/uia_*.csv

# Whitelist safe templates, test fixtures, and synthetic spike results
!templates/contoh_*.csv
!installer/assets/contoh_*.csv
!**/fixtures/**/*.csv
!spike-results/*.csv
!spike-results/*_summary.txt

# Local end-to-end / staging test data
e2e-test/

# Signing keys and certificates
*.pfx
*.p12
*.snk
*.key
*.pem
*.cer
*.crt
*.der
*.csr

# ---------------------------------------------------------------------------
# 3. .NET / C# Build & Compiler Outputs
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild[Ll]og.*
[Bb]uild[Pp]rocess[Tt]ools/

# Executables, libraries, and debug symbols
*.exe
*.com
*.dll
*.so
*.dylib
*.pdb
*.idb
*.lib
*.exp
*.ilk
*.res
*.obj
*.pch
*.ipch

# NuGet packages and caches
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Test Results & Coverage
TestResult.xml
[Tt]est[Rr]esult*/
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage/

# ---------------------------------------------------------------------------
# 4. Packaging, Publishing & Installer Outputs
# ---------------------------------------------------------------------------
publish/
publish-fx/
dist/
out/
artifacts/
installer/Output/
*.msi
*.msix
*.msm
*.msp
*.appx
*.appxbundle
*.zip
*.7z
*.tar.gz

# ---------------------------------------------------------------------------
# 5. IDE, Editors & Development Tools
# ---------------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.jfm
*.cache
*.VisualState.xml
*.vspscc
*.vssscc

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, ReSharper)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.resharper.user
.idea/
*.iml

# AI / Assistant & Scratch directories
.gemini/
.agent/
scratch/
temp/
tmp/
*.tmp
*.bak
*.orig
*~
*.swp
*.swo

# ---------------------------------------------------------------------------
# 6. Operating System Files
# ---------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
.directory
